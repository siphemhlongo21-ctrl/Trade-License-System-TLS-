  <diagram id="oyFK1VllmFCYNatt0YQQ" name="Responsive UI Adjustment">
    <mxGraphModel dx="2641" dy="1595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph REQ[\&quot;Requirement\&quot;]\n        A([Task 8109: Responsive UI for all devices and all roles])\n    end\n\n    subgraph SHARED[\&quot;Shared layer: every role gets it through _Layout.cshtml\&quot;]\n        B[\&quot;tls-responsive.css, sections 1 to 17, added to the ~/Content/css bundle in BundleConfig.cs\&quot;]\n        C[\&quot;tls-sidebar.js: sidebar toggle, close button, Esc key, remembered state\&quot;]\n        D[\&quot;tls-responsive.js: table scroll wrapper and stacked table cards\&quot;]\n        E[\&quot;_Layout.cshtml: early head script, script tags, old header logout removed\&quot;]\n        F[\&quot;Error.cshtml and Loginerror.cshtml: viewport tag added\&quot;]\n    end\n\n    subgraph HEADER[\&quot;Header and sidebar\&quot;]\n        H1[\&quot;Panel icon on the hamburger button, centred\&quot;]\n        H2[\&quot;Sidebar open by default on desktop, hidden by default below 992px\&quot;]\n        H3[\&quot;Overlay behind the sidebar on small screens\&quot;]\n        H4[\&quot;Logout moved to the header, top right\&quot;]\n        H5[\&quot;Header is a flex row: menu icon, title with ellipsis, Logout\&quot;]\n        H6[\&quot;Logout label shown from 768px up, icon only below 768px\&quot;]\n    end\n\n    subgraph PAGES[\&quot;Page patterns\&quot;]\n        P1[\&quot;Dashboard tiles: 1 column on phones, 2 on tablets, 4 on large screens\&quot;]\n        P2[\&quot;Search block and panels: stay inside the screen below 992px\&quot;]\n        P3[\&quot;Wide tables: scroll inside their own box\&quot;]\n        P4[\&quot;Phones, tables with 4+ columns: each row shown as a card\&quot;]\n        P5[\&quot;License Details buttons: tls-actions wraps onto new rows\&quot;]\n        P6[\&quot;Below 992px: no sideways page scroll\&quot;]\n    end\n\n    subgraph ROLES[\&quot;Roles using the same layer\&quot;]\n        R1[\&quot;Administrator\&quot;]\n        R2[\&quot;Chief Inspector, Siphiwe Zwane\&quot;]\n        R3[\&quot;Department Manager, Pieter Venter\&quot;]\n        R4[\&quot;Clerks and other roles\&quot;]\n    end\n\n    subgraph TEST[\&quot;Testing, working locally\&quot;]\n        T1[\&quot;Chrome DevTools device toolbar: iPhone SE, iPad Mini, Surface Pro, iPad Pro, Nest Hub Max, foldables\&quot;]\n        T2[\&quot;Hard reload Ctrl+Shift+R, or Rebuild Solution if the bundle is cached\&quot;]\n        T3[\&quot;Overflow finder snippet: outlines elements wider than the screen\&quot;]\n        T4{\&quot;All devices pass?\&quot;}\n    end\n\n    subgraph GIT[\&quot;Delivery\&quot;]\n        G1[\&quot;Commit on branch FR_8109\&quot;]\n        G2[\&quot;Push and open PR into develop\&quot;]\n        G3[\&quot;Senior review\&quot;]\n    end\n\n    A --&gt; B\n    A --&gt; C\n    A --&gt; D\n    A --&gt; E\n    A --&gt; F\n    C --&gt; H1\n    C --&gt; H2\n    C --&gt; H3\n    C --&gt; H4\n    B --&gt; H5\n    B --&gt; H6\n    B --&gt; P1\n    B --&gt; P2\n    D --&gt; P3\n    D --&gt; P4\n    B --&gt; P5\n    B --&gt; P6\n    H4 --&gt; H5 --&gt; H6\n    SHARED --&gt; ROLES\n    HEADER --&gt; ROLES\n    PAGES --&gt; ROLES\n    ROLES --&gt; T1\n    T1 --&gt; T2 --&gt; T3 --&gt; T4\n    T4 --&gt;|No| B\n    T4 --&gt;|Yes| G1 --&gt; G2 --&gt; G3&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CZdsqCuFjZsdLpS2zYJy-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
