@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.ItemSubCategoryId)

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Update Item Sub-Category</h3>
            </div>
            <div class="panel-body">
                <div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                            <span class="sr-only">Success: </span>
                            @TempData["Success"].ToString()

                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                            <span class="sr-only">Error: </span>
                            @TempData["Error"].ToString()
                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info">
                            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                            <span class="sr-only">Info: </span>
                            @TempData["Info"].ToString()
                        </div>
                    }
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.ItemTypeId, "Item Type", new { @class = "control-label col-md-2 required-field" })
                    <div class="col-md-3">
                        @Html.DropDownList("ItemTypeId", null, "Please select Item Type.", new { @class = "form-control"})
                        @Html.ValidationMessageFor(model => model.ItemTypeId)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ItemSubCategoryName, new { @class = "control-label col-md-2 required-field" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ItemSubCategoryName)
                        @Html.ValidationMessageFor(model => model.ItemSubCategoryName)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ItemSubCategoryDescription, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ItemSubCategoryDescription)
                        @Html.ValidationMessageFor(model => model.ItemSubCategoryDescription)
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Save" class="btn btn-outline-success" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
</div>

