@model PagedList.IPagedList<C8.TradeLicense.Models.License>
@using C8.TradeLicense.Models
@using C8.TradeLicense.DataAccessLayer
@using PagedList.Mvc;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Welcome to eThekwini's Trade License System";
}
@{
    //var pendingLinceseInspection = (PagedList.IPagedList<License>)ViewData["PendingLicenseInpection"];
    var db = new TradeLicenseDbContext();
}

<style>
    .md-bg-light-green-600:hover {
        background-color: tomato !important;
        color: black !important;
    }
    .md-bg-light-blue-600:hover {
        background-color: tomato !important;
        color: black !important;
    }
    .md-bg-orange-600:hover {
        background-color: tomato !important;
        color: black !important;
    }
    .md-bg-purple-600:hover {
        background-color: tomato !important;
        color: black !important;
    }
    
    .myDashboardLink:hover {
        text-decoration: none;
    }
</style>

<div id="page_content" >
    <div id="page_content_inner">

        <!-- statistics (small charts) note_add -->
        <div class="uk-grid">
            <div>
                <div class="md-card md-bg-light-green-600">
                    <a class="myDashboardLink" href="/License/NotRenewed">
                        <div class="md-card-content">
                            <div class="uk-float-right uk-margin-top uk-margin-small-right"><i class="material-icons md-color-white md-48">notifications</i></div>
                            <h3 class="uk-margin-remove"><span class="countUpMe md-color-white">Not Renewed</span><span class="badge">@ViewBag.NotRenewed</span></h3>
                        </div>
                    </a>
                </div>
            </div>
            <div>
                <div class="md-card md-bg-light-blue-600">
                    <a class="myDashboardLink" href="/License/ApprovedLicenses">
                        <div class="md-card-content">
                            <div class="uk-float-right uk-margin-top uk-margin-small-right"><i class="material-icons md-color-white md-48">done</i></div>
                            <h3 class="uk-margin-remove"><span class="countUpMe md-color-white">Approved License</span><span class="badge">@ViewBag.Approved</span></h3>
                        </div>
                    </a>
                </div>
            </div>
            <div>
                <div class="md-card md-bg-orange-600">
                    <a class="myDashboardLink" href="/License/RevokedLicenses">
                        <div class="md-card-content">
                            <div class="uk-float-right uk-margin-top uk-margin-small-right"><i class="material-icons md-color-white md-48">assignment_late</i></div>
                            <h3 class="uk-margin-remove"><span class="countUpMe md-color-white">Revoked License</span><span class="badge">@ViewBag.Revoked</span></h3>
                        </div>
                    </a>
                </div>
            </div>
            <div>
                <div class="md-card md-bg-purple-600">
                    <a class="myDashboardLink" href="/License/LicenseRenewal">
                        <div class="md-card-content">
                            <div class="uk-float-right uk-margin-top uk-margin-small-right"><i class="material-icons md-color-white md-48">notifications</i></div>
                            <h3 class="uk-margin-remove"><span class="countUpMe md-color-white">Pending Renewal</span><span class="badge">@ViewBag.Renewal</span></h3>
                        </div>
                    </a>
                </div>
            </div>

        </div>

        <!-- tasks -->
        <div class="uk-grid" data-uk-grid-margin data-uk-grid-match="{target:'.md-card-content'}">
            <div class="uk-width-medium-1-1">
                            <h1 align="center" style="background-color:cornflowerblue;color:white;">Pending Licenses</h1>
                <br />
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-overflow-container">
                            @if (Model.Count() > 0)
                            {

                            <table class="uk-table">
                                <thead>
                                    <tr>
                                        <th class="uk-text-nowrap">Customer Name</th>
                                        <th class="uk-text-nowrap">Status</th>
                                        <th class="uk-text-nowrap">Date of Application</th>
                                        <th class="uk-text-nowrap uk-text-right">Proposed Business Name</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        <tr class="uk-table-middle">
                                            <td class="uk-width-3-10 uk-text-nowrap">
                                                @Html.DisplayFor(modelItem => item.Client.Name)
                                                @Html.DisplayFor(modelItem => item.Client.Surname)
                                            </td>
                                            <td class="uk-width-3-10 uk-text-nowrap">
                                                @Html.DisplayFor(modelItem => item.Status.StatusName)
                                            </td>

                                            <td class="uk-width-3-10 uk-text-nowrap">
                                                @Html.DisplayFor(modelItem => item.ApplicationDateTime)
                                            </td>

                                            <td class="uk-width-3-10 uk-text-nowrap">
                                                @Html.DisplayFor(modelItem => item.Business.ProposedTradeName)
                                            </td>
                                            <td class="uk-width-3-10 uk-text-nowrap">
                                                @{
                                                    License License = db.Licenses.Find(item.LicenseId);
                                                    var statuspendingInspection = db.Status.Where(s => s.StatusKey == "PendingLicenseInspection").Select(s => s.StatusId).FirstOrDefault();
                                                    if (License.StatusId != statuspendingInspection)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = item.LicenseId })">
                                                            <i class="glyphicon glyphicon-pencil" title="Edit"></i>
                                                            <span class="sr-only">Edit</span>
                                                        </a>
                                                        <a href="@Url.Action("Delete", new { id = item.LicenseId })">
                                                            <i class="glyphicon glyphicon-remove" title="Cancel Application"></i>
                                                        </a>
                                                        <span class="sr-only">Cancel Application</span>
                                                    }
                                                    <a href="@Url.Action("Details","License", new { id = item.LicenseId })">
                                                        <i class="glyphicon glyphicon-list" title="View Details"></i>
                                                        <span class="sr-only">Details</span>
                                                    </a>

                                                }
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                            <div align="center">

                                Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                                @Html.PagedListPager(Model, page => Url.Action("Index",
             new { page, selectedSearch = ViewBag.selecetedSearch, currentFilter = ViewBag.CurrentFilter }))

                            </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
           
        </div>

    </div>
</div>


