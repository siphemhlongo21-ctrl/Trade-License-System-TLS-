@model PagedList.IPagedList<C8.TradeLicense.Models.Enquiry>
@using PagedList;
@using PagedList.Mvc;

@{
    ViewBag.Title = "Index";
}

@*<h2>Index</h2>*@

<script type="text/javascript">
    $(function () {
        $('#btnSearch').click(function () {
            var inp = $("#inputSearch").val();
            var criteria = $("input[name=selectedSearch]:checked").val();
            $(document).trigger("clear-alert-id.errormsg");

            if (criteria == null) {
                alert("Please choose a search criteria!");
            }
            else {
                if (inp.length <= 0) {
                    alert("Please enter a value to search for!");
                }
            }

        });

        $('#SelectionSearch-form').submit(function (e) {
            if (!$('#inputSearch').val()) {
                e.preventDefault(); // Prevents Form POST when textbox is empty
            } else
                if ($("input[name=selectedSearch]:checked").val() == null) {
                    e.preventDefault(); // Prevents Form POST when search criteria is not selected
                }
        });
    });
</script>

@using (Html.BeginForm("Index", "Enquiry", FormMethod.Get, new { id = "SelectionSearch-form" }))
{
    <div class="alert alert-info">
        <h5 style="font-family: italic">Select a search option below.</h5>
        @Html.RadioButton("selectedSearch", "BusinessName")&nbsp;Trading Name
        @Html.RadioButton("selectedSearch", "ClientName")&nbsp;Client Name
        @Html.TextBox("inputSearch", ViewBag.FilterValue as string)
        <input type="submit" value="Search" id="btnSearch" />
        <a href="@Url.Action("Index")">
            <i class="glyphicon glyphicon-refresh" title="Refresh"></i>
        </a>
    </div>
}

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Enquiries - <span class="badge">@ViewBag.EnquiriesCount</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                @*<th>
                        @Html.DisplayNameFor(model => model.ModifiedByUser.FirstName)
                    </th>*@
                <th>
                    @Html.DisplayNameFor(model => model.FirstOrDefault().ClientName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FirstOrDefault().ProposedTradeName)
                </th>
                @*<th>
                        @Html.DisplayNameFor(model => model.PostalAddress1)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PostalAddress2)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PostalAddress3)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PostalAddressCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.EnquiryReport)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InspectorsReport)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsDeleted)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsLocked)
                    </th>*@
                <th>
                    @Html.Label("Department")
                </th>
                <th>
                    @Html.Label("Created By ")
                    @*@Html.DisplayNameFor(model => model.CreatedByUser.FullName)*@
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FirstOrDefault().CreatedDateTime)
                </th>
                @*<th>
                        @Html.DisplayNameFor(model => model.ModifiedDateTime)
                    </th>*@
                <th></th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.ModifiedByUser.FirstName)
                        </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.ClientName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProposedTradeName)
                    </td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.PostalAddress1)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PostalAddress2)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PostalAddress3)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PostalAddressCode)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.EnquiryReport)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.InspectorsReport)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsDeleted)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsLocked)
                        </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.Department.DepartmentName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedByUser.FullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDateTime)
                    </td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.ModifiedDateTime)
                        </td>*@
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id=item.EnquiryId }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("View Enquiry", "Details", new { id = item.EnquiryId }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.EnquiryId }, new { @class = "btn btn-outline-warning" })
                    </td>
                </tr>
            }

        </table>
        <div align="center">
            Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
            @Html.PagedListPager(Model, page => Url.Action("Index",
             new { page, selectedSearch = ViewBag.selecetedSearch, currentFilter = ViewBag.CurrentFilter }))
        </div>
    </div>
</div>





