@model C8.TradeLicense.Models.Enquiry

@{
    ViewBag.Title = "Edit";
}

@*<h2>Edit</h2>*@

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Edit Enquiry</h3>
    </div>

    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true)
                <div>
                    @Html.HiddenFor(model => model.EnquiryId, new { Value = ViewBag.EnquiryId })
                </div>
                <div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                            <span class="sr-only">Success: </span>
                            @TempData["Success"].ToString()

                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                            <span class="sr-only">Error: </span>
                            @TempData["Error"].ToString()
                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info">
                            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                            <span class="sr-only">Info: </span>
                            @TempData["Info"].ToString()
                        </div>
                    }
                </div>
                
                <div class="form-group">
                    @Html.LabelFor(model => model.ClientName, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ClientName)
                        @Html.ValidationMessageFor(model => model.ClientName)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ProposedTradeName, new { @class = "control-label col-md-2" })
