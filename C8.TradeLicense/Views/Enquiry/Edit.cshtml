                        @Html.TextBoxFor(model => model.PostalAddressCode)
                        @Html.ValidationMessageFor(model => model.PostalAddressCode)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.LicenseTypeId, new { @class = "control-label col-md-2" })
