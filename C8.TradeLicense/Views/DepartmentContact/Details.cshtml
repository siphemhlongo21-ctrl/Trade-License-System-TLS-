@model C8.TradeLicense.Models.DepartmentContact

@{
    ViewBag.Title = "Details";
}

<div>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" href="#collapseOne">Department Contact Details</a>
            </h4>
        </div>

        <div class="panel-collapse collapse in">
            <div class="panel-body">
                <dl class="dl-horizontal">
                    <dt>
                        @Html.Label("Department Name")
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model._DepartmentId.DepartmentName)
                    </dd>

                    <dt>
                        @Html.Label("Inspector")
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.User.FullName)
                    </dd>

                    <dt>
                        @Html.Label("Chief Inspector")
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.DepartmentHeadContact.User.FullName)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => model.IsPrinciple)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.IsPrinciple)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => model.CreatedDateTime)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.CreatedDateTime)
                    </dd>

                    <dt>
                        @Html.LabelFor(model => model.CreatedByUser.FullName, "Created By")
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.CreatedByUser.FullName)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => model.ModifiedDateTime)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.ModifiedDateTime)
                    </dd>

                    <dt>
                        @Html.LabelFor(model => model.ModifiedByUser.FullName, "Modified By")
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.ModifiedByUser.FullName)
                    </dd>

                </dl>
            </div>
        </div>
    </div>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.DepartmentContactId }, new { @class = "btn btn-outline-success" }) |
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
</p>
