@using C8.TradeLicense.ViewModels;
@model AmendmentReviewVM
@{
    ViewBag.Title = "Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<h2>Review Amendment</h2>

<div class="card p-3 mb-3">
    <p><strong>Amendment ID:</strong> @Model.AmendmentId</p>
    <p><strong>License Number:</strong>@Html.ActionLink(@Model.LicenseNumber, "Details", "License", new { id = Model.LicenseId }, new { target = "_blank" }) </p>
    <p><strong>Amendment Type:</strong> @Model.AmendmentType</p>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Section</th>
            <th>Field</th>
            <th>Current Value</th>
            <th>Requested Value</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Changes)
        {
            <tr>
                <td>@item.TableName</td>
                <td>@item.FieldName</td>
                <td class="text-danger">@item.OldValue</td>
                <td class="text-success">@item.NewValue</td>
            </tr>
        }
    </tbody>
</table>
@if (Model.BusinessDocuments.Count() > 0)
{
    <strong>Business Uploaded Documents</strong>

    <table class="table-bordered">
        <tr>
            <th>Document Type</th>
            <th>FileName</th>
            <th>Created Date</th>
        </tr>
        @foreach (var item in Model.BusinessDocuments)
        {
            <tr>
                <td style="padding-right: 10px">@item.Document.DocumentName </td>
                <td style="padding-right: 10px"><a target="_blank" href="@C8.TradeLicense.Keys.ActionLinkKeys.SharePointDownload@item.FilePath">@item.FileName</a></td>
                <td style="padding-right: 10px">@item.Uploadeddate</td>

            </tr>

        }
    </table>
}
<div class="mt-3">

    @using (Html.BeginForm("Approve", "Amendment"))
    {
        <input type="hidden" name="amendmentId" value="@Model.AmendmentId" />

        <button type="submit" class="btn btn-success">@Model.ApprovalDisplay</button>
    }

    @using (Html.BeginForm("Reject", "Amendment"))
    {

        <input type="hidden" name="amendmentId" value="@Model.AmendmentId" />

        <button type="submit" class="btn btn-danger mt-2">@Model.RejectionDisplay</button>
        <hr />
        <textarea rows="5" class="form-control" name="reason" placeholder="Rejection reason"></textarea>
    }

</div>

