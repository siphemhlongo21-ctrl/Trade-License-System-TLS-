@model IEnumerable<C8.TradeLicense.Models.BusinessOperationType>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create",null, new { @class = "btn btn-outline-warning" })
</p>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Business Operation Types - <span class="badge">@ViewBag.BusinessOppTypeCount</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.BusinessOperationTypeName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BusinessOperationTypeDescription)
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.BusinessOperationTypeName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BusinessOperationTypeDescription)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.BusinessOperationTypeId }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("Details", "Details", new { id = item.BusinessOperationTypeId }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.BusinessOperationTypeId }, new { @class = "btn btn-outline-warning" })
                    </td>
                </tr>
            }

        </table>
    </div>
</div>
