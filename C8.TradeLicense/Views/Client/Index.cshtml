<script type="text/javascript">
    //$(document).ready(function () {
    //    $('#inputSearch').prop('disabled', true);
    //    $('#btnSearch').prop('disabled', true);
    //});

    $(function () {
        $('#btnSearch').click(function () {
            var inp = $("#inputSearch").val();
            var criteria = $("input[name=selectedSearch]:checked").val();
            $(document).trigger("clear-alert-id.errormsg");

            if (criteria == null) {
                alert("Please choose a search criteria!");

            } else {
                if (inp.length <= 0) {
                    alert("Please enter a value to search for!");

                }   
            }

        });

        $('#SelectionSearch-form').submit(function (e) {
            if (!$('#inputSearch').val()) {
                e.preventDefault(); // Prevents Form POST when textbox is empty
            } else
                if ($("input[name=selectedSearch]:checked").val() == null) {
                    e.preventDefault(); // Prevents Form POST when search criteria is not selected
                }
        });
    });
</script>
@{
    ViewBag.Title = "Index";
    var db = new TradeLicenseDbContext();


        var businesses = (IEnumerable<Business>)ViewData["ClientBusinessesList"];
   
}




@using (Html.BeginForm("Index", "Client", FormMethod.Get, new { id = "SelectionSearch-form" }))
{
    <div class="alert alert-info">

        <h5>Select Search Option Below:</h5>
        <div id="SelectionSearch" class="form-group " align="left">

            @Html.RadioButton("selectedSearch", "ClientName")&nbsp;Customer Name
            @Html.RadioButton("selectedSearch", "IDPassportNumber")&nbsp;ID/Passport
            @Html.TextBox("inputSearch", ViewBag.FilterValue as string)
            <input type="submit" value="Search" id="btnSearch" />
            <a href="@Url.Action("Index")">
                <i class="glyphicon glyphicon-refresh" title="Refresh"></i>
            </a>
        </div>
        <div style="text-align: right">
            @*@Html.ActionLink("Create New Client", "Create")*@
            <a href="@Url.Action("Create", "Client", null)" class="btn btn-primary">Create New Customer</a>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-danger">
        <a class="close" data-dismiss="alert">×</a>
        @TempData["Error"].ToString()
    </div>
}

