<script src="~/Scripts/jquery-steps.js"></script>

<script>

    //$('#demo').steps({

    //    onFinish: function () { submit("Submit") }
    //});
            var form = $("#clientInfo-form");
            form.children("div").steps({
               
                onFinish: function () {
                    $('#ResidentialAddress1').prop("disabled", false);
                    $('#ResidentialAddress2').prop("disabled", false);
                    $('#ResidentialAddress3').prop("disabled", false);
                    $('#ResidentialAddressCode').prop("disabled", false);
                    $("#clientInfo-form").submit();
                },
                onChange: function (event, currentIndex, newIndex) {
                    debugger;
                    //submit(currentIndex, newIndex)

                    if (newIndex < currentIndex) {
                        return true;
                    }
                    form.validate().settings.ignore = ":disabled,:hidden";
                    return form.valid();

        }
    });

    $("table").addClass("table table-bordered")
    // gets postalcode  from API
    function postalcode(element, CityOfPPA, SubOfPPAC) {
        debugger;
        var settingsSubOfPPAC = {

            'cache': false,

            'dataType': "jsonp",

            "async": true,

            "crossDomain": true,

            "url": "http://10.10.6.105/IRCAMAPI/MasterdataAPIs/PostalSuburbs/FilterSearch.php?CITY=" + CityOfPPA + "&POSTAL_AREA=" + SubOfPPAC,
            "method": "GET",

            "headers": {

                "accept": "application/json",

                "Access-Control-Allow-Origin": "*"

            }

        }
        $.ajax(settingsSubOfPPAC).done(function (response) {

            if (response['AddressData'].length != null) {

                if (response['AddressData'][0].POSTAL_AREA != null) {
                    debugger;  
                   
                       
                   
                    var t = response['AddressData'][0].POSTAL_CODE;
                  
                    $('#' + element).val(parseInt(t));
                    document.getElementById(element).defaultValue = t;
                    $('#' + element).disabled = "true"
                }
