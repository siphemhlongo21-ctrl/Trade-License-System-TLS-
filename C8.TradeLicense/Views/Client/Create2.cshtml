                    alert("error");
                    //location.reload();
                }
            }
            //$('#' + element).show();

        })


  
    }
    // gets Suburb list from API
    function sub(CityOfPPA, element,isSame) {
       
        var settingsSubOfPPA = {

            'cache': false,

            'dataType': "jsonp",

            "async": true,

            "crossDomain": true,

            "url": "http://10.10.6.105/IRCAMAPI/MasterdataAPIs/PostalSuburbs/FilterSearch.php?CITY=" + CityOfPPA + "&POSTAL_AREA=",

            "method": "GET",

            "headers": {

                "accept": "application/json",

                "Access-Control-Allow-Origin": "*"

            }

        }
        $.ajax(settingsSubOfPPA).done(function (response) {

            var array = [];
            if (response['AddressData'].length != null) {



                for (var J = 0; J < response['AddressData'].length; J++) {
                    if (response['AddressData'][J].POSTAL_AREA != null) {
                        array.indexOf(response['AddressData'][J].POSTAL_AREA) === -1 ? array.push(response['AddressData'][J].POSTAL_AREA) : console.log();

                        //console.log()

                    }



                }
                array.sort();
                for (var s = 0; s < array.length; s++) {

                    $('#' + element).append("<option class='" + array[s] + "' value='" + array[s] + "'>" + array[s] + "</option>");

                    if (isSame == "true") {
                        $("#ResidentialAddress2").val($("#PostalAddress2").val());
                    }

                }
            }

            else if (response['AddressData'].length == 0) {
                alert("error");
                //location.reload();
            }
            $('#selectSubOfPdiv').show();

        })
    }
