<script type="text/javascript">
    function submit(bth) {

        debugger;
        isValid = true;
    

        $('input,select', $("#ClientDetails")).each(
            function () {
                if ($(this).attr('required') == "required" || $(this).attr('required') == true) {
                    if (document.getElementById($(this).attr('id')).value == "") {
                        document.getElementById($(this).attr('id')).style.border = '1px solid red'
