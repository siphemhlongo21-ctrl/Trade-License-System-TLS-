                            isValid = false;
                            //
                        }
                    }
                    else if (document.getElementById($(this).attr('id')).id == "item_DocumentId") {
                        isValid = true;
                    }
                    else if (document.getElementById($(this).attr('id')).id == "CellphoneNumber") {


                        var str = document.getElementById("CellphoneNumber").value;

                        if (str.length != 10) // validates cell No
                        {
                            document.getElementById("CellphoneNumber").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }
                    else if (document.getElementById($(this).attr('id')).id == "TelephoneNumber") {


                        var str = document.getElementById("TelephoneNumber").value;

                        if (str.length != 7) // validates cell No
                        {
                            document.getElementById("TelephoneNumber").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }
                    else if (document.getElementById($(this).attr('id')).id == "ResidentialAddressCode") {


                        var str = document.getElementById("ResidentialAddressCode").value;

                        if (str.length != 4) // validates cell No
                        {
                            document.getElementById("ResidentialAddressCode").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }

                    else if (document.getElementById($(this).attr('id')).id == "PostalAddressCode") {


                        var str = document.getElementById("PostalAddressCode").value;

                        if (str.length != 4) // validates cell No
                        {
                            document.getElementById("PostalAddressCode").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }
                    else {
                        document.getElementById($(this).attr('id')).style.border = ''
                    }
                }



                if (isValid == true)//if valid, submit form if button clicked
                {
                    debugger;
                    if (btn == "Save") {

                        document.getElementById("btnSave").click()
                    }
                    else {

               

                    }

                }
                else {
                    document.getElementById("Erroralert").hidden = false;
                    document.getElementById("error2").innerHTML = "Please fill in all Required Fields marked with an (*)";



                }








            });
    }

    function Nationalitychange(element) {
        debugger
        if (element.value == "Other") {
            document.getElementById("DivNationalityOther").hidden = false;
            document.getElementById("DivExpiryPermit").hidden = false;

            document.getElementById("NationalityOther").required = true;
            document.getElementByName("ExpiryPermit").required = true;

        }
        else if (element.value == "South African National") {
            document.getElementById("DivNationalityOther").hidden = true;
            document.getElementById("DivExpiryPermit").hidden = true;
            document.getElementById("NationalityOther").required = false;
            document.getElementByName("ExpiryPermit").required = false;
        }
        else {
            document.getElementById("NationalityOther").required = false;
            document.getElementsByName("ExpiryPermit").required = true;
            document.getElementById("DivNationalityOther").hidden = true;
            document.getElementById("DivExpiryPermit").hidden = false;
        }
    }
    function CustomerT(element) {
        debugger;
        if (element.value == "Business") {




            document.getElementById("DivBusinessName").hidden = false;



            document.getElementById("BusinessName").required = true

            document.getElementById("DivRegNumber").hidden = false;


            document.getElementById("RegNumber").required = true;

            document.getElementById("DivNationality").hidden = true;


            document.getElementById("Nationality").required = false;
            document.getElementById("DivIdentityOrPassportNumber").hidden = false;


            document.getElementById("IdentityOrPassportNumber").required = true;
            document.getElementsByName("ExpiryPermit").required = false;

            document.getElementById("DivExpiryPermit").hidden = true;
        }
        else {
            document.getElementById("DivNationality").hidden = false;


            document.getElementById("Nationality").required = true;
            document.getElementById("DivIdentityOrPassportNumber").hidden = false;


            document.getElementById("IdentityOrPassportNumber").required = true;

            document.getElementById("DivRegNumber").hidden = true;


            document.getElementById("RegNumber").required = false;

            document.getElementById("DivBusinessName").hidden = true;


            document.getElementById("BusinessName").required = false;

        }
    }
    $(document).ready(function () {
        Nationalitychange(document.getElementById("Nationality"))
        var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(ViewBag.OustandingDocuments))';
        var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);

        var groupList = [];

        $.each(outstandingDocuments, function (index, value) {
            groupList.push('<li>' + value + '</li>');
        });

        if (groupList.length > 0) {
            $('#outstandingDocumentList').append(groupList.join(''));
            $('#documentAlert').show();
        }

    });

    $(document).ready(function () { //
        $(".longString").each(function () {
            var maxwidth = 30;
            if ($(this).text().length > maxwidth) {
                $(this).text($(this).text().substring(0, maxwidth));
                $(this).html($(this).html() + '...');
            }
        });
    });
    $(document).ready(function () {
        var picker = new Pikaday({
            field: document.getElementById('datetimepicker'),
            format: 'YYYY/MM/DD HH:MM',
            toString(date, format) {
                var today = new Date();
                const day = ('0' + (date.getDate())).slice(-2);
                const month = ('0' + (date.getMonth() + 1)).slice(-2);
                const year = date.getFullYear();
                const hour = today.getHours();
                const min = ('0' + today.getMinutes()).slice(-2);

                return `${year}-${month}-${day} ${hour}:${min}`;
            }
        });

    });
</script>

@using (Html.BeginForm("Edit", "Client", FormMethod.Post, new { enctype = "multipart/form-data", id = "ClientDetails" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <a class="close" data-dismiss="alert">×</a>
                <strong>Success!</strong>@TempData["Success"].ToString()
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-block">
                <a class="close" data-dismiss="alert">×</a>
                <h4 class="alert-heading">Warning!</h4>
