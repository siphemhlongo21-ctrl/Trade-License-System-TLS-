        <div class="col-md-offset-2 col-md-10" align="right">
            <input type="button" onclick="submit('Save')" value="Save" class="btn btn-default" />
            <input type="submit"hidden="hidden" id="btnSave" value="Save2" class="btn btn-default" />
            &nbsp; 
            @{
        var db = new TradeLicenseDbContext();
        if (Model.ClientStatusId == db.Status.Where(s => s.StatusKey == "ClientApproved").Select(s => s.StatusId).
            FirstOrDefault())
        {
                <a class="btn btn-default" href="@Url.Action("Create", "Business", new { id = Model.ClientId })">
                    <span class="font-icon-group"></span>Add Business 
                </a>
        }
            }


        </div>


    </div>

}

