                       @* @Html.Label("Recieved?", new { style = "font-style: italic; font-weight: normal; font-size:10; align: right" })
                        @Html.CheckBox("isRecieved", new { id = "isRecieved" })*@
                    </h4>
                </div>
                <div id="collapseTwo" class="panel-collapse collapse in">
                    <div class="panel-body">
                        @if (documentTypes.Count() > 0)
                        {
                            @Html.Partial("~/Views/Shared/_UploadPartial.cshtml", documentTypes)
                        }

                        @if (documentsList.Any())
                        {
                            <table class="table-bordered">
                                <tr>
                                    <th>Document Type</th>
                                    <th>FileName</th>
                                    <th>Created Date</th>
                                </tr>
                                @foreach (var item in documentsList)
                                {
                                    <tr>
                                        <td style="padding-right: 10px">@item.Document.DocumentName </td>
                                        <td style="padding-right: 10px">@Html.ActionLink(item.FileName, "Download", "Client", new { id = item.FileUploadId, file = item.FileName, clientId = Model.ClientId }, new { @class = "longString", @title = item.FileName })</td>
                                        <td style="padding-right: 10px">@item.CreatedDateTime</td>
                                    </tr>

                                }
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (businesses.Any())
        {
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseFour">Client Registered Business
