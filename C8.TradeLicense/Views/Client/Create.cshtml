    function addsearch() {

        $("#AddressStatus").hide();
        $('#rippleload').show();

        if ((!$('#StreetNumber').val()) && (!$('#StreetName').val()) && (!$('#Suburb').val()) && (!$('#StreetType').val()) && (!$('#Erf').val()) && (!$('#Portion').val()) && (!$('#FarmTownship').val())) {

            $("#AddressSearchTable").find("tr:gt(0)").remove();
            $('#rippleload').hide();
            $("#AddressStatus").show();
            $("#AddressStatus").empty();
            $("#AddressStatus").append("<center><div class='alert alert-danger'>Please fill in atleast one field.</div></center>");

        } else {
            $('#rippleload').show();
            $("#AddressStatus").hide();

        }

        $.get("http://YOUR_HOST:8099/PublicSectorHousing/config/searchAddress.php?StreetNumber=" + $('#StreetNumber').val() + "&StreetName=" + $('#StreetName').val() + "&Suburb=" + $('#Suburb').val() + "&StreetType=" + $('#StreetType').val() + "&Erf=" + $('#Erf').val() + "&Portion=" + $('#Portion').val() + "&FarmTownship=" + $('#FarmTownship').val() + "&rem=", initLoadHoldOnClose(), function (data, status) {

            var AddressResponse = JSON.parse(data);

            if (AddressResponse.AddressData.length == 0) {

                $("#AddressStatus").show();
                $('#rippleload').hide();
