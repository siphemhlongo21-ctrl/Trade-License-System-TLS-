<script src="~/Scripts/jquery-steps.js"></script>

<script>

    var form = $("#clientInfo-form");
    form.children("div").steps({

        onFinish: function () {

            $('#ResidentialAddress1').prop("disabled", false);
            $('#ResidentialAddress2').prop("disabled", false);
            $('#ResidentialAddress3').prop("disabled", false);
            $('#ResidentialAddressCode').prop("disabled", false);


            var IdentityDoc = $("#UploadTable #identity_document #file").val();
            var landloadDoc = $("#UploadTable #landlord_consent #file").val();
            var consetDoc = $("#UploadTable #town_planning_consent #file").val();
            var telephone = $("#TelephoneNumber").val();
            var telephonecode = $("#TelephoneNumberCode").val();
            if (telephone == "" || telephonecode == "") {
                $("#TelephoneNumber").val("");
                $("#TelephoneNumberCode").val("");
            }

            var telephone1 = $("#FaxNumber").val();
            var telephonecode1 = $("#FaxNumbercode").val();
            if (telephone1 == "" || telephonecode1 == "") {
                $("#FaxNumber").val("");
                $("#FaxNumbercode").val("");
            }
            if (IdentityDoc.length != 0 && landloadDoc.length != 0 && consetDoc.length != 0) {
                initLoadHoldOn("Saving Customer..Please Wait");
                $("#clientInfo-form").submit();
            } else {
                alert("Please make sure that all required documents are uploaded");
            }


        },
        onChange: function (event, currentIndex, newIndex) {
            //submit(currentIndex, newIndex)

            if (newIndex < currentIndex) {
                return true;
            }
            form.validate().settings.ignore = ":disabled,:hidden";
            return form.valid();

        }
    });

    $("table").addClass("table table-bordered")




    function submit(currentIndex, newIndex) {

        isValid = true;
        var step = "";
        if (currentIndex == 1) {
            step = "DivCustomerDeatils"
        }

        $('input,select', $("#" + step)).each(

            function () {

                if ($(this).attr('required') == "required" || $(this).attr('required') == true) {
                    if (document.getElementById($(this).attr('id')).value == "") {
                        document.getElementById($(this).attr('id')).style.border = '1px solid red'
                        if (isValid == true) {
                            isValid = false;
                            //
                        }
                    }
                    else if (document.getElementById($(this).attr('id')).id == "item_DocumentId") {
                        isValid = true;
                    }
                    else if (document.getElementById($(this).attr('id')).id == "CellphoneNumber") {


                        var str = document.getElementById("CellphoneNumber").value;

                        if (str.length != 10) // validates cell No
                        {
                            document.getElementById("CellphoneNumber").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }
                    else if (document.getElementById($(this).attr('id')).id == "TelephoneNumber") {


                        var str = document.getElementById("TelephoneNumber").value;

                        if (str.length != 7) // validates cell No
                        {
                            document.getElementById("TelephoneNumber").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }
                    else if (document.getElementById($(this).attr('id')).id == "ResidentialAddressCode") {


                        var str = document.getElementById("ResidentialAddressCode").value;

                        if (str.length != 4) // validates cell No
                        {
                            document.getElementById("ResidentialAddressCode").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }

                    else if (document.getElementById($(this).attr('id')).id == "PostalAddressCode") {


                        var str = document.getElementById("PostalAddressCode").value;

                        if (str.length != 4) // validates cell No
                        {
                            document.getElementById("PostalAddressCode").style.border = '1px solid red'
                            if (isValid == true) {
                                isValid = false;
                                //
                            }
                        }
                    }
                    else {
                        document.getElementById($(this).attr('id')).style.border = ''
                    }
                }


                if (isValid == true)//if valid, submit form if button clicked
                {
                    if (btn == "Save") {

                        document.getElementById("btnSave2").click()
                    }
                    else {

                        if (newIndex < currentIndex) {
                            return true;
                        }
                        var form = $("#clientInfo-form");
                        form.validate().settings.ignore = ":disabled,:hidden";
                        return form.valid();

                    }

                }
                else {
                    document.getElementById("Erroralert").hidden = false;
                    document.getElementById("error2").innerHTML = "Please fill in all Required Fields marked with an (*)";



                }





            });
    }

