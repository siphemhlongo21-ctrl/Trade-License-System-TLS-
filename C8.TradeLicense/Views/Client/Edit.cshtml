    }
    function emailnotreq(element) {
        if (element.value.length > 5) {
            document.getElementById("EmailAddress").required = false;
            document.getElementById("lblEmailAddress").className = "control-label col-md-2";
        }
        else {
            document.getElementById("EmailAddress").required = true;
            document.getElementById("lblEmailAddress").className = "control-label col-md-2 required-field";
        }
    }

    function CustomerT(element) {

        if (element.value == "Business") {




            document.getElementById("DivBusinessName").hidden = false;



            document.getElementById("BusinessName").required = true

            document.getElementById("DivRegNumber").hidden = false;


            document.getElementById("RegNumber").required = true;

            document.getElementById("DivNationality").hidden = true;


            document.getElementById("Nationality").required = false;
            document.getElementById("DivIdentityOrPassportNumber").hidden = false;


            document.getElementById("IdentityOrPassportNumber").required = true;
            document.getElementById("ExpiryPermit").required = false;

            document.getElementById("DivExpiryPermit").hidden = true;
        }
        else {
            document.getElementById("BusinessName").value = "";



            document.getElementById("RegNumber").value = "";
            document.getElementById("DivNationality").hidden = false;


            document.getElementById("Nationality").required = true;
            document.getElementById("DivIdentityOrPassportNumber").hidden = false;


            document.getElementById("IdentityOrPassportNumber").required = true;

            document.getElementById("DivRegNumber").hidden = true;


            document.getElementById("RegNumber").required = false;

            document.getElementById("DivBusinessName").hidden = true;


            document.getElementById("BusinessName").required = false;

        }
    }

</script>

