            }

        }
        $.ajax(settingsSubOfPPA).done(function (response) {

            var array = [];
            if (response['AddressData'].length != null) {



                for (var J = 0; J < response['AddressData'].length; J++) {
                    if (response['AddressData'][J].POSTAL_AREA != null) {
