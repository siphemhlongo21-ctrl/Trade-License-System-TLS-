@model C8.TradeLicense.Models.LicenseType

@{

}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Edit License Type</h3>
    </div>
    <div class="panel-body">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">

                @Html.ValidationSummary(true)
                @Html.HiddenFor(model => model.LicenseTypeId)
                <div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                            <span class="sr-only">Success: </span>
                            @TempData["Success"].ToString()

                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                            <span class="sr-only">Error: </span>
                            @TempData["Error"].ToString()
                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info">
                            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                            <span class="sr-only">Info: </span>
                            @TempData["Info"].ToString()
                        </div>
                    }
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.LicenseTypeName, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.LicenseTypeName)
                        @Html.ValidationMessageFor(model => model.LicenseTypeName)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.LicenseTypeDescription, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.LicenseTypeDescription)
                        @Html.ValidationMessageFor(model => model.LicenseTypeDescription)
                    </div>
                </div>
                <div class="form-group" hidden="hidden">
                    @Html.LabelFor(model => model.LicenseTypeKey, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.LicenseTypeKey)
                        @Html.ValidationMessageFor(model => model.LicenseTypeKey)
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Amount, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Amount)
                        @Html.ValidationMessageFor(model => model.Amount)
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Save" class="btn btn-outline-success" />
                    </div>
                </div>
            </div>
        }

        <div>
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
        </div>
    </div>
</div>
