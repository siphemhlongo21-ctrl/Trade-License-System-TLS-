@model C8.TradeLicense.Models.LicenseApplicationDetails
@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models

@{
    ViewBag.Title = "Administrator Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var InspectionResponse =Model.InspectionResponses;
    var User = Model.UserDetails;
    var appeal =Model.InspectionAppealsReviewsDetails;
    var AppealReview =Model.InspectionAppealsReviews;
    var AminReview = Model.AdministratorReviews;
    var ChiefReview = Model.ChiefReviews;
    var ManagerReview = Model.ManagerReviews;
    var InspectorDocs = Model.InspectionResponseDocuments;
    var DepartmentContactlist = Model.DepartmentContacts;
    var documentsList = Model.ClientUploadList;
    var db = new TradeLicenseDbContext();
}

<div id="errorResponse" class="alert alert-warning" style="display:none;">
</div>
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />

    <link rel="icon" type="image/png" href="assets/img/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="assets/img/favicon-32x32.png" sizes="32x32">

    <title>Trading License</title>

    <style>
        .number {
            background-color: transparent !important;
            border: 1.5px solid white;
            border-radius: 50px;
            color: white !important;
        }

        .step-app > .step-steps > li > a {
            display: block;
            padding: 10px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
        }

        legend {
            display: block;
            width: 100%;
            padding: 0;
            margin-bottom: 20px;
            font-size: 25px;
            line-height: inherit;
            color: #333;
            border: 0;
            background-color: aliceblue;
            border-bottom: 1px solid #00d0ff;
        }

        .error {
            color: tomato;
        }
    </style>
</head>


<br />
<br />
<br />


<br />
<br />
<br />
<body class="disable_transitions sidebar_main_open sidebar_main_swipe">


    @using (Html.BeginForm("Create", "InspectionAppealsReviews", FormMethod.Post, new { @Id = "CreateForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @*Success message*@
        <div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                    @*<a class="close" data-dismiss="alert">×</a>*@
                    @*<strong>Success!</strong>@TempData["Success"].ToString()*@
                    <span class="sr-only">Success: </span>
                    @TempData["Success"].ToString()
                </div>
            }
        </div>
        <div>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                    @*<a href="#" class="close" data-dismiss="alert">&times;</a>
                        <strong>Error!</strong> @TempData["Error"].ToString()*@
                    <span class="sr-only">Error: </span>
                    @TempData["Error"].ToString()
                </div>
            }
        </div>
        <div>
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">
                    <a class="close" data-dismiss="alert">×</a>
                    <strong>Note!</strong>
                    @TempData["Info"].ToString()
                </div>
            }
        </div>

        @Html.ValidationSummary(true)





        <div id="demo">
            <div class="step-app">
                <ul class="step-steps">
                    <li><a href="#step1"><span class="number">1</span>Appeal Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step2"><span class="number">2</span>Inspection History <span class="glyphicon glyphicon-arrow-right"></span></a></li>

                    <li><a href="#step3"> <span class="number">3</span>Previous Review <span class="glyphicon glyphicon-arrow-right"></span></a></li>

                    <li><a href="#step4"> <span class="number">4</span> Manager Decision</a></li>

                </ul>
                <div class="step-content">

                    <div class="step-tab-panel" id="step1" align="center">
                        <div>
                            <table>
                                <legend>Appeallent Information</legend>
                                <tr>
                                    <td>Full Name </td>
                                    <td>:@Model.InspectionAppealDetails.Name    @Model.InspectionAppealDetails.Surname</td>
                                </tr>

                                <tr>
                                    <td>Individual Type</td>
                                    <td>: @Model.InspectionAppealDetails.Individual</td>
                                </tr>
                                <tr>
                                    <td>Nationality</td>
                                    @if (Model.InspectionAppealDetails.Nationality == "Other")
                                    {
                                      <td>: @Model.InspectionAppealDetails.NationalityOther</td>
                                    }
                                    else
                                    {
                                        <td>: @Model.InspectionAppealDetails.Nationality</td>
}

                                </tr>
                                <tr>
                                    <td>Identity Or PassportNumber </td>
                                    <td>: @Model.InspectionAppealDetails.IdentityOrPassportNumber</td>
                                </tr>
                                <tr>
                                    <td>Appeal date </td>
                                    <td>: @Model.InspectionAppealDetails.AppealDate</td>
                                </tr>
                                <tr>
                                    <td>Telephone Number</td>
                                    <td>:@Model.InspectionAppealDetails.TelephoneNumber</td>
                                </tr>

                                <tr>
                                    <td>Cellphone Number</td>
                                    <td>:@Model.InspectionAppealDetails.CellphoneNumber</td>
                                </tr>
                                <tr>
                                    <td>Email Address</td>
                                    <td>:@Model.InspectionAppealDetails.EmailAddress</td>
                                </tr>
                                <tr>
                                    <td>Residential Address</td>
                                    <td>:@Model.InspectionAppealDetails.ResidentialAddress </td>
                                </tr>
                                <tr>
                                    <td>Postal Address</td>
                                    <td>:@Model.InspectionAppealDetails.PostalAddress </td>
                                </tr>
                                <tr>
                                    <td>Reason for Appeal</td>
                                    <td>: @Model.InspectionAppealDetails.Reason</td>
                                </tr>

                            </table>
                        </div>


                        <div class="form-group" id="uploadReportGroup">

                            @if (documentsList.Any())
                            {
                                <table class="table-bordered">
                                    <tr>
                                        <th>Document Type</th>
                                        <th>FileName</th>
                                        <th>Uploaded By</th>
                                        <th>Created Date</th>
                                    </tr>
                                    @foreach (var item in documentsList)
                                    {
                                        <tr>
                                            <td style="padding-right: 10px">@item.Document.DocumentName </td>
                                               <td style="padding-right: 10px"><a target="_blank" href="@C8.TradeLicense.Keys.ActionLinkKeys.SharePointDownload@item.FilePath">@item.FileName</a></td>
                                            <td style="padding-right: 10px">@item.Uploadedby </td>
                                            <td style="padding-right: 10px">@item.Uploadeddate</td>
                                        </tr>

                                    }
                                </table>
                            }
                        </div>
                    </div>
                    <div class="step-tab-panel" id="step2" align="center">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Response Details</legend>
                        <div>


                            <div class="panel-group" id="accordion">
                                <div class="panel panel-default">

                                    <div id="collapseOne" class="panel-collapse collapse in">
                                        <div class="panel-body">





                                            <table class="table">

                                                <tr>
                                                    <th>
                                                        @Html.DisplayName("Inspector Name")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Inspection Date")
                                                    </th>

                                                    <th>
                                                        @Html.DisplayName("Inspection Status")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Clerk")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Captured By Clerk")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Adhoc inspection")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Comment")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Report")
                                                    </th>


                                                </tr>

                                                @foreach (var item in Model.InspectionHistorys)
                                                {
                                                    <tr>
                                                        @foreach (var DepartmentCont in DepartmentContactlist)
                                                        {
                                                            if (DepartmentCont.DepartmentContactId == item.InspectionRequest.DepartmentContactId)
                                                            {

                                                                <td>

                                                                    @DepartmentCont.User.FullName
                                                                </td>
                                                            }
                                                        }
                                                        <td>
                                                            @item.InspectionDateTime
                                                        </td>

                                                        <td>
                                                            @item.Status.StatusName
                                                        </td>
                                                        <td>
                                                            @item.Clerk
                                                        </td>
                                                        <td>
                                                            @if (item.CapturedByClerk == false)
                                                            {
                                                                @Html.DisplayName("No")
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayName("Yes")
                                                            }

                                                        </td>
                                                        <td>
                                                            @if (item.AdhocInspector == false)
                                                            {
                                                                @Html.DisplayName("No")
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayName("Yes")
                                                            }

                                                        </td>

                                                        <td>
                                                            @item.Comment
                                                        </td>
                                                        <td style="padding-right: 10px">
                                                            @if (InspectorDocs.Any() || InspectorDocs != null)
                                                            {
                                                                foreach (var Report in InspectorDocs)
                                                                {
                                                                    if (Report.referenceId == item.InspectionResponseId)
                                                                    {



                                                                        <a target="_blank" href="@C8.TradeLicense.Keys.ActionLinkKeys.SharePointDownload@Report.FilePath">@Report.FileName</a>

                                                                        break;
                                                                    }

                                                                }
                                                            }



                                                        </td>

                                                    </tr>
                                                }

                                            </table>




                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                    <div class="step-tab-panel" id="step3" align="center">
                        <br />
                        <br />
                        <br />

                        @Html.Partial("~/Views/Shared/_ReviewPartial.cshtml")



                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step4">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Review </legend>
                        <div class="form-horizontal">

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            @Html.HiddenFor(model => model.InspectionAppealDetails.InspectionAppealId, new { Value = Model.InspectionAppealDetails.InspectionAppealId })
                            @Html.HiddenFor(model => model.InspectionAppealsReviewsDetails.InspectionAppealId, new { Value = Model.InspectionAppealDetails.InspectionAppealId })
                            @Html.HiddenFor(model => model.InspectionAppealsReviewsDetails.UserId, new { Value = @User.UserId })


                            <div class="form-group">
                                @Html.LabelFor(model => model.UserDetails.UserId, "User Name", htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.Editor("Username", new { htmlAttributes = new { Value = @User.FullName, @class = "form-control", @required = "required" } })
                                   @* @Html.HiddenFor(model => model.InspectionAppealsReviewsDetails.UserId, new { htmlAttributes = new { Value = @User.UserId, @class = "form-control" } })*@


                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.InspectionAppealsReviewsDetails.Decision, htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(model => model.InspectionAppealsReviewsDetails.Decision, new SelectList(new[] { "Approve", "Reject" }), "Select Decision", new { @class = "form-control", Onchange = "decision(this)", @required = "required" })
                                    @Html.ValidationMessageFor(model => model.InspectionAppealsReviewsDetails.Decision, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.InspectionAppealsReviewsDetails.Comment, htmlAttributes: new { @class = "control-label col-md-2", id = "lblComment" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.InspectionAppealsReviewsDetails.Comment, 8, 45, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.InspectionAppealsReviewsDetails.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.InspectionAppealsReviewsDetails.DateReviewed, htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.InspectionAppealsReviewsDetails.DateReviewed, new { htmlAttributes = new { @class = "form-control", @required = "required" ,@id = "DateReviewed" } })
                                    @Html.ValidationMessageFor(model => model.InspectionAppealsReviewsDetails.DateReviewed, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.InspectionAppealsReviewsDetails.InspectionAppeal.AppealDateTime, htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.Editor("AppealDateTime", new { htmlAttributes = new { @class = "form-control", @id = "AppealDateTime", @required = "required" } })
                                    @Html.ValidationMessageFor(model => model.InspectionAppealsReviewsDetails.InspectionAppeal.AppealDateTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group" hidden>
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" id="Createbtn" value="Create" class="btn btn-default" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="step-footer">
                        <div align="left" class="col-lg-3">
                            @Html.ActionLink("Back to List", "Index", "InspectionAppeals", null, new { @class = "btn btn-outline-primary" })
                        </div>
                        <div align="center" class="col-lg-6">
                            <button data-direction="prev" class="btn btn-outline-primary">Previous</button>
                            <button data-direction="next" class="btn btn-outline-primary">Next</button>
                            <button data-direction="finish" class="btn btn-outline-success">Submit</button>

                        </div>
                        <br />
                        <br />
                    </div>
                </div>


            </div>
        </div>
    }
    <!-- Date Picker -->

    <script src="~/Scripts/datepicker/bootstrap-datepicker.js"></script>
    <link href="~/Scripts/datepicker/datepicker3.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-steps.js"></script>
    <script type="text/javascript">
        //$('#demo').steps({
        //    onFinish: function () { document.getElementById("Createbtn").click(); }
        //});
        function decision(element) {
            if (element.value == "Reject") {
                document.getElementById("Comment").required = true;
                document.getElementById("lblComment").className = "required-field control-label col-md-2";
            }
            else {
                document.getElementById("Comment").required = false;
                document.getElementById("lblComment").className = "control-label col-md-2";
            }
        }
        var form = $("#CreateForm");
        form.children("div").steps({

            onFinish: function () {
                $('#Username').prop("disabled", false);
                document.getElementById("Createbtn").click();
            },
            onChange: function (event, currentIndex, newIndex) {
                debugger;
                //submit(currentIndex, newIndex)

                if (newIndex < currentIndex) {
                    return true;
                }
                form.validate().settings.ignore = ":disabled,:hidden";
                return form.valid();

            }
        });

        $("table").addClass("table table-bordered")


        $(document).ready(function () {
            $('#Username').prop("disabled", true);
            var AppealDateTime = new Pikaday({
                field: document.getElementById('AppealDateTime'),
                format: 'YYYY/MM/DD',
                minDate: new Date(),
                toString(date, format) {
                    var today = date;
                    const day = ('0' + (today.getDate())).slice(-2);
                    const month = ('0' + (today.getMonth() + 1)).slice(-2);
                    const year = today.getFullYear();


                    return `${year}-${month}-${day}`;
                }
            });
            var DateReviewed = new Pikaday({
                field: document.getElementById('DateReviewed'),
                format: 'YYYY/MM/DD',
                minDate: new Date(),
                toString(date, format) {
                    var today = date;
                    const day = ('0' + (today.getDate())).slice(-2);
                    const month = ('0' + (today.getMonth() + 1)).slice(-2);
                    const year = today.getFullYear();


                    return `${year}-${month}-${day}`;
                }
            });

            var DateReviewed = new Pikaday({
                field: document.getElementById('DateReviewed'),
                format: 'YYYY/MM/DD HH:MM',
                maxDate: new Date(),
                toString(date, format) {
                    var today = new Date();
                    const day = ('0' + (date.getDate())).slice(-2);
                    const month = ('0' + (date.getMonth() + 1)).slice(-2);
                    const year = date.getFullYear();
                    const hour = today.getHours();
                    const min = ('0' + today.getMinutes()).slice(-2);

                    return `${year}-${month}-${day} ${hour}:${min}`;
                }
            });

        });


    </script>
</body>


</html>



