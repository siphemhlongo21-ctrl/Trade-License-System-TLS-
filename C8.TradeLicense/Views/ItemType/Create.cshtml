@using (Html.BeginForm("Create", "ItemType", FormMethod.Post, new { id = "CreateForm", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true)

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Create Item Type</h3>
            </div>
            <div class="panel-body">
                <div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                            <span class="sr-only">Success: </span>
                            @TempData["Success"].ToString()

                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                            <span class="sr-only">Error: </span>
                            @TempData["Error"].ToString()
                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info">
                            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                            <span class="sr-only">Info: </span>
                            @TempData["Info"].ToString()
                        </div>
                    }
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.ItemTypeName, new { @class = "control-label col-md-2 required-field" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ItemTypeName, new { @class = "form-control", @required = "required" })
                        @Html.ValidationMessageFor(model => model.ItemTypeName)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ItemTypeDescription, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ItemTypeDescription, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ItemTypeDescription)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ItemTypeKey, new { @class = "control-label col-md-2 required-field" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ItemTypeKey, new { @class = "form-control", @required = "required" })
                        @Html.ValidationMessageFor(model => model.ItemTypeKey)
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button data-direction="finish" class="btn btn-outline-success">Submit</button>
                        <div hidden="hidden">
                            <input type="submit"id="Createbtn" value="Create" class="btn btn-default" />
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
</div>

<script type="text/javascript">
        var form = $("#CreateForm");
        form.children("div").steps({

            onFinish: function () {


                document.getElementById("Createbtn").click();
            },
            onChange: function (event, currentIndex, newIndex) {
                debugger;
                //submit(currentIndex, newIndex)

                if (newIndex < currentIndex) {
                    return true;
                }
                form.validate().settings.ignore = ":disabled,:hidden";
                return form.valid();

            }
        });
</script>