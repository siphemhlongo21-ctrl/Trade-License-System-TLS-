@model C8.TradeLicense.Models.Status

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.StatusId)

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Update Item Type</h3>
            </div>

            <div class="panel-collapse in">
                <div class="panel-body">
                    <div>
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">
                                <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                                <span class="sr-only">Success: </span>
                                @TempData["Success"].ToString()

                            </div>
                        }
                    </div>
                    <div>
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                                <span class="sr-only">Error: </span>
                                @TempData["Error"].ToString()
                            </div>
                        }
                    </div>
                    <div>
                        @if (TempData["Info"] != null)
                        {
                            <div class="alert alert-info">
                                <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                                <span class="sr-only">Info: </span>
                                @TempData["Info"].ToString()
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.StatusName, new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.StatusName)
                            @Html.ValidationMessageFor(model => model.StatusName)
                        </div>
                    </div>

                    <div class="form-group" hidden="hidden">
                        @Html.LabelFor(model => model.StatusKey, new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.StatusKey)
                            @Html.ValidationMessageFor(model => model.StatusKey)
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.StatusDescription, new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.StatusDescription)
                            @Html.ValidationMessageFor(model => model.StatusDescription)
                        </div>
                    </div>
                    <div class="form-group" hidden="hidden">
                        @Html.LabelFor(model => model.StatusTypeId, "Status Type", new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.DropDownList("StatusTypeId", null, "Select Status Type", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StatusTypeId)
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Save" class="btn btn-outline-success" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
</div>

