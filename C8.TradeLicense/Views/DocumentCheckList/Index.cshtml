@model IEnumerable<C8.TradeLicense.Models.DocumentCheckList>

@{
    ViewBag.Title = "Index";
}

@*<h2>Index</h2>*@

<p>
    @Html.ActionLink("Add Document Checklist Type", "Create",null, new { @class = "btn btn-outline-warning" })
</p>

@*@Html.Partial("~/Views/LicenseDocument/_LicenseDocumentPartialView.cshtml")*@

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Document Checklist Types - <span class="badge">@ViewBag.DocumentListCount</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LicenseType.LicenseTypeName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Document.DocumentName)
                </th>
                <th></th>
            </tr>

            @foreach (var entry in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => entry.LicenseType.LicenseTypeName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => entry.Document.DocumentName)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = entry.DocumentCheckListId }, new { @class = "btn btn-outline-warning" }) |
                        @Html.ActionLink("Details", "Details", new { id = entry.DocumentCheckListId }, new { @class = "btn btn-outline-warning" }) 
                        @*@Html.ActionLink("Delete", "Delete", new { id = entry.DocumentCheckListId }, new { @class = "btn btn-outline-warning" })*@
                    </td>
                </tr>
            }

        </table>
    </div>
</div>


