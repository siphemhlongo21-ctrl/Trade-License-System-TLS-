@model IEnumerable<C8.TradeLicense.Models.InspectionResponse>
@using C8.TradeLicense.Models

@{
    ViewBag.Title = "Index";
}

@{
    int id = Convert.ToInt32(ViewContext.RouteData.Values["id"]);
}


<div class="alert alert-warning" id="inspectionRequestAlert" style="display:none;">
    <strong>Awaiting Inspection Response</strong> from the following department(s):
    <ul id="outstandingDepartmentList"></ul>
</div>

<div class="alert alert-danger" id="inspectionResponseAlert" style="display:none;">
    License has received a negative response from the following department(s):
    <ul id="failedDepartmentList"></ul>
</div>


@{
    if (User.IsInRole("Administrator"))
    {
        <script type="text/javascript">
            $(document).ready(function () {
                var jsonResponseList = '@Html.Raw(Json.Encode(ViewBag.OutstandingResponses))';
                var jsonFailedInspections = '@Html.Raw(Json.Encode(ViewBag.FailedInspections))';
                var outstandingResponses = JSON.parse(jsonResponseList);
                var failedInspections = JSON.parse(jsonFailedInspections);

                var groupList = [];

                $("#submitInspections").val("Process License");

                $.each(outstandingResponses, function (index, value) {
                    groupList.push('<li>' + value.Department.DepartmentName + '</li>');
                });

                if (groupList.length > 0) {
                    $('#outstandingDepartmentList').append(groupList.join(''));
                    $('#inspectionRequestAlert').show();
                    $('#submitInspections').attr("disabled", true);
                }
                else if (failedInspections.length > 0) {
                    $.each(failedInspections, function (index, value) {
                        if ($.trim(value.Status.StatusKey) === "InspectionFailed") {
                            groupList.push('<li>' + value.Department.DepartmentName + '</li>');
                        }
                    });

                    $('#failedDepartmentList').append(groupList.join(''));
                    $('#inspectionResponseAlert').show();
                    $('#submitInspections').attr("disabled", true);
                }
                else {
                    $('#inspectionResponseAlert').hide();
                }
            });

        </script>
    }
}


