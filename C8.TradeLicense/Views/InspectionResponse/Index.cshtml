@model C8.TradeLicense.Models.LicenseApplicationDetails
@using PagedList;
@using PagedList.Mvc;

@{
    ViewBag.Title = "Index";
}


<script type="text/javascript">

    $(function () {
        $('#btnSearch').click(function () {
            var inp = $("#inputSearch").val();
            var criteria = $("input[name=selectedSearch]:checked").val();
            $(document).trigger("clear-alert-id.errormsg");

            if (criteria == null) {
                alert("Please choose a search criteria!");
            }
            else {
                if (inp.length <= 0) {
                    alert("Please enter a value to search for!");
                }
            }

        });

        $('#SelectionSearch-form').submit(function (e) {
            if (!$('#inputSearch').val()) {
                e.preventDefault(); // Prevents Form POST when textbox is empty
            } else
                if ($("input[name=selectedSearch]:checked").val() == null) {
                    e.preventDefault(); // Prevents Form POST when search criteria is not selected
                }
        });
    });
</script>

@using (Html.BeginForm("Index", "InspectionResponse", FormMethod.Get, new { id = "SelectionSearch-form" }))
{
    <div class="alert alert-info">
        <h5 style="font-family: italic">Select a search option below.</h5>
        @Html.RadioButton("selectedSearch", "BusinessName")&nbsp;Business Name
        @Html.RadioButton("selectedSearch", "ClientName")&nbsp;Client Name
        @Html.TextBox("inputSearch", ViewBag.FilterValue as string)
        <input type="submit" value="Search" id="btnSearch" />
        <a href="@Url.Action("Index")">
            <i class="glyphicon glyphicon-refresh" title="Refresh"></i>
        </a>
    </div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Inspection Responses - <span class="badge">@Model.InspectionRequests.Count()</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    @Html.DisplayName("Client Name")
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LicenseDetails.Business.ProposedTradeName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LicenseDetails.Status.StatusName)
                </th>
                @*<th>
                        @Html.DisplayName("Modified By")
                    </th>*@
                <th>
                    @Html.DisplayNameFor(model => model.InspectionRequestDetails.SlaExpiryDate)
                </th>


                <th>Action</th>

            </tr>

            @foreach (var item in Model.InspectionRequests)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.License.Client.Fullname)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.License.Business.ProposedTradeName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Status.StatusName)
                    </td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.ModifiedByUser.FullName)
                        </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.SlaExpiryDate)
                    </td>
                    @if (item.Status.StatusKey == "PendingLicenseInspection")
                    {
                        <td>
                            <a href="@Url.Action("Create", new { id = item.InspectionRequestId  })">
                                <i class="glyphicon glyphicon-plus" title="Add"></i>
                                <span class="sr-only">add</span>
                            </a>
                            <a href="@Url.Action("LicenseDocUploads","License", new { licenseId = item.LicenseId,Screen ="InspectionResponse"  })">
                                <i class="glyphicon glyphicon-briefcase" title="View Documents"></i>
                                <span class="sr-only">Documents</span>
                            </a>
                        </td>
                    }
                    else
                    {
                        <td>
                            @if (item.Status.StatusKey != "AwaitingManagerResponse" && item.Status.StatusKey != "InspectionFailed")
                            {
                                <a href="@Url.Action("Edit", new { id = item.InspectionRequestId })">
                                    <i class="glyphicon glyphicon-pencil" title="Edit"></i>
                                    <span class="sr-only">Edit</span>
                                </a>


                            }

                            <a href="@Url.Action("LicenseDocUploads","License", new { licenseId = item.LicenseId,Screen ="InspectionResponse" })">
                                <i class="glyphicon glyphicon-briefcase" title="View Documents"></i>
                                <span class="sr-only">Documents</span>
                            </a>

                        </td>


                    }

                </tr>
            }

        </table>
        <div align="center">
            Page @(Model.IPagedInspection.PageCount < Model.IPagedInspection.PageNumber ? 0 : Model.IPagedInspection.PageNumber) of @Model.IPagedInspection.PageCount
            @Html.PagedListPager(Model.IPagedInspection, page => Url.Action("Index",
            new { page, selectedSearch = Model.SelectedSearch, currentFilter = Model.CurrentFilter }))
        </div>
    </div>
</div>

