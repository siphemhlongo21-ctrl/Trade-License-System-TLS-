@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Error";
    Layout = null;
}
<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Error</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <style>
        .error-template {
            padding: 40px 15px;
            text-align: center;
        }

        .error-actions {
            margin-top: 15px;
            margin-bottom: 15px;
        }

            .error-actions .btn {
                margin-right: 10px;
            }
    </style>
</head>
<body style="background-color:#ecf0f5">
    <form id="form1">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="error-template">
                        <h1>Oops!</h1>
                        <h3>Previous session was not logged out correctly.</h3>
                        <div class="error-actions">

                            <a href="~/Account/Login" id="Login" class="btn btn-default btn-lg"><span class="glyphicon glyphicon"></span><strong>Go To Login Page</strong></a>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="main-footer">
            <div class="pull-right hidden-xs">
                <b>Version</b> 1.0
            </div>
            <strong>Copyright &copy; @DateTime.Now.Year </strong> All rights
            reserved.
        </footer>

    </form>
</body>
</html>


