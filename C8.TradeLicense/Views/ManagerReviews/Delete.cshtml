@model C8.TradeLicense.Models.ManagerReview
@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models
@{
    ViewBag.Title = "Managers Review";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var InspectionResponse = (IEnumerable<InspectionResponse>)ViewData["InspectionResponse"];

    var User = (User)ViewData["Userdata"];
    var client = (Client)ViewData["ClientData"];
    var business = (Business)ViewData["BusinessData"];

    var DepartmentContact = (IEnumerable<DepartmentContact>)ViewData["DepartmentContactdata"];
    var licenseType = (LicenseType)ViewData["LicenseType"];
    var itemType = (ItemType)ViewData["ItemType"];
    var documentTypes = (IEnumerable<Document>)ViewData["Documents"];
    //var documentsList = (IEnumerable<FileUpload>)ViewData["UploadList"];
    var license = (License)ViewData["licenceData"];
    var db = new TradeLicenseDbContext();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />

    <link rel="icon" type="image/png" href="assets/img/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="assets/img/favicon-32x32.png" sizes="32x32">

    <title>Trading License</title>

    <style>
        .number {
            background-color: transparent !important;
            border: 1.5px solid white;
            border-radius: 50px;
            color: white !important;
        }

        .step-app > .step-steps > li > a {
            display: block;
            padding: 10px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
        }

        legend {
            display: block;
            width: 100%;
            padding: 0;
            margin-bottom: 20px;
            font-size: 25px;
            line-height: inherit;
            color: #333;
            border: 0;
            background-color: aliceblue;
            border-bottom: 1px solid #00d0ff;
        }
           .error {
        color: tomato;
    }
    </style>
</head>


<br />
<br />
<br />
<body class="disable_transitions sidebar_main_open sidebar_main_swipe">
