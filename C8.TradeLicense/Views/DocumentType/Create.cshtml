@model C8.TradeLicense.Models.DocumentType

@{
    ViewBag.Title = "Create";
}

@*<h2>Create</h2>*@

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true)

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Create Document Type</h3>
            </div>
            <div class="panel-collapse in">
                <div class="panel-body">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentTypeName, new { @class = "control-label col-md-2 required-field" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DocumentTypeName)
                            @Html.ValidationMessageFor(model => model.DocumentTypeName)
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentTypeDescription, new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DocumentTypeDescription)
                            @Html.ValidationMessageFor(model => model.DocumentTypeDescription)
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentTypeKey, new { @class = "control-label col-md-2 required-field" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DocumentTypeKey)
                            @Html.ValidationMessageFor(model => model.DocumentTypeKey)
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Submit" class="btn btn-outline-success" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*<h4>DocumentType</h4>
            <hr />*@
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index",null, new { @class = "btn btn-outline-primary" })
</div>
