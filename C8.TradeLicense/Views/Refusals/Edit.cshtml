    <script type="text/javascript">
        $('#demo').steps({
            onFinish: function () { document.getElementById("Createbtn").click(); }
        });

        $("table").addClass("table table-bordered")
        $('#ExpiryPermit').datepicker({
            format: 'mm/dd/yyyy',

        });
        $('#AppealDate').datepicker({
            format: 'mm/dd/yyyy',

        });
        function Nationalitychange(element) {

            if (element.value == "Other") {
                document.getElementById("DivNationalityOther").hidden = false;
                document.getElementById("DivExpiryPermit").hidden = false;

                document.getElementById("DivNationalityOther").required = true;
                document.getElementById("DivExpiryPermit").required = true;
            }
            else if (element.value != "South African National") {
                document.getElementById("DivNationalityOther").hidden = true;
                document.getElementById("DivExpiryPermit").hidden = false;
                document.getElementById("DivNationalityOther").required = false;
                document.getElementById("DivExpiryPermit").required = true;
            }
            else {
                document.getElementById("DivNationalityOther").required = false;
                document.getElementById("DivExpiryPermit").required = false;
                document.getElementById("DivNationalityOther").hidden = true;
                document.getElementById("DivExpiryPermit").hidden = true;
            }
        }

        var isSame = "false"
        $(document).ready(function () {
            $('#isSame').change(function () {
                var isChecked = $(this).is(':checked');
                if (isChecked) {


                    isSame = "true"
                    $("#PostalAddress1").val(  $("#ResidentialAddress1").val())
                    $("#PostalAddress2").val($("#ResidentialAddress2").val())
                    $("#PostalAddress3").val($("#ResidentialAddress3").val());
                    $("#PostalAddressCode").val($("#ResidentialAddressCode").val())
                    document.getElementById("PostalAddressCode").defaultValue = parseInt($("#ResidentialAddressCode").val());


                } else {
                    $("#PostalAddress1").val("");
                    $("#PostalAddress2").val("");
                    $("#PostalAddress3").val("");
                    $("#PostalAddressCode").val("");
                    document.getElementById("PostalAddressCode").defaultValue = "";

                    $('#postalAddress').show();
                }
            });



        });
    </script>
