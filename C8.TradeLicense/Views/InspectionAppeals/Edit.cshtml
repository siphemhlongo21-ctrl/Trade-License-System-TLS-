    <script>
        $(document).ready(function () {
            @*var currentItemType = $("#ddlItemTypeName option:selected").text();
            $("#ClientId").val('@client.ClientId');
            if (currentItemType !== "Item 2") {
                $("#fingerprint_verification").hide();
            }*@

            $("#LicenseId").val('@licence.LicenseId');
            $("#InspectionResponseId").val('@InspectionResponse.InspectionResponseId');
            $("#InspectionRequestId").val('@InspectionRequest.InspectionRequestId');
            var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(ViewBag.OustandingDocuments))';
            var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);
            var groupList = [];

            $.each(outstandingDocuments, function (index, value) {
                groupList.push('<li>' + value + '</li>');
            });

            if (groupList.length > 0) {
                $('#outstandingDocumentList').append(groupList.join(''));
                $('#documentAlert').show();
            }


        });
        //TODO: Validating File Types
        var validFilesTypes = [".bmp", ".gif", ".png", ".jpg", ".jpeg", ".doc", ".xls", ".pdf", ".docx", ".xlsx"];
        $(document).bind("change", "#file", function (e) {
            var file = $('input[type=file]').val();
            var isValidFile = false;
            if (file) {
                var ext = file.substring(file.lastIndexOf("."), file.length).toLowerCase();
                for (var i = 0; i < validFilesTypes.length; i++) {
                    if (ext == validFilesTypes[i]) {
                        isValidFile = true;
                        break;
                    }
                }
                if (!isValidFile) {
                    alert("Invalid File. Refer supported file types below:\n\n" + validFilesTypes.join(", "));
                    $('#file').replaceWith($('#file').clone());
                }
            }
        });

    </script>
