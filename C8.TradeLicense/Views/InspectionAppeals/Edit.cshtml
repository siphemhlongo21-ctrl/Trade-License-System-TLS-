        function ValidateRSAIDNo() {
            try {
                var id = document.getElementById("IdentityOrPassportNumber").value;
                debugger;
                if (id.length != 13) {
                    $('#IdentityOrPassportNumber').val('');
                    //alert("Please enter a valid 13 digit ID no.");
                    document.getElementById("Identitynumspan").hidden = false;
                    document.getElementById("IdentityOrPassportNumbererror").innerHTML = "Please enter a valid 13 digit ID no.";

                    return false;
                }
                var y1o = id.substring(0, 1)
                var y2e = id.substring(1, 2)
                var m1o = id.substring(2, 3)
                var m2e = id.substring(3, 4)
                var d1o = id.substring(4, 5)
                var d2e = id.substring(5, 6)
                var go = id.substring(6, 7)
                var s1e = id.substring(7, 8)
                var s2o = id.substring(8, 9)
                var s3e = id.substring(9, 10)
                var co = id.substring(10, 11)
                var ae = id.substring(11, 12)
                var z = id.substring(12, 13)

                var A = 0;
                A = parseInt(A) + parseInt(y1o) + parseInt(m1o) + parseInt(d1o) + parseInt(go) + parseInt(s2o) + parseInt(co);
                var B1 = y2e + m2e + d2e + s1e + s3e + ae;
                var B2 = B1 * 2;
                var i = 0;
                var B3 = 0;
                var B2string = B2.toString();
                while (B2string.length > i) {
                    var x = B2string.substring(i, i + 1);
                    B3 = B3 + parseInt(x);
                    i = i + 1;
                }

                var C = A + B3;
                var Cstring = C.toString();
                var secNo = Cstring.substring(1, 2);
                var D = 10 - parseInt(secNo);
                while (D >= 10) D = D - 10;
                if (D == z) {
                    //test for valid date in 1900
                    var valid = true;
                    var bd = new Date('19' + y1o + y2e, parseInt(m1o + m2e) - 1, d1o + d2e);
                    if ((bd == 'NaN') | (bd == 'Invalid Date')) valid = false;
                    else if (bd.getFullYear() != parseInt('19' + y1o + y2e)) valid = false;
                    else if (bd.getMonth() + 1 != parseInt(m1o + m2e)) valid = false;
                    else if (bd.getDate() != parseInt(d1o + d2e)) valid = false;
                    //if invalid test again in 2000
                    valid = true;
                    bd = new Date('20' + y1o + y2e, parseInt(m1o + m2e) - 1, d1o + d2e);
                    if ((bd == 'NaN') | (bd == 'Invalid Date')) valid = false;
                    else if (bd.getFullYear() != parseInt('20' + y1o + y2e)) valid = false;
                    else if (bd.getMonth() + 1 != parseInt(m1o + m2e)) valid = false;
                    else if (bd.getDate() != parseInt(d1o + d2e)) valid = false;


                    var tempDate = new Date(id.substring(0, 2), id.substring(2, 4) - 1, id.substring(4, 6));

                    var id_date = tempDate.getDate();
                    var id_month = tempDate.getMonth();
                    var id_year = tempDate.getFullYear();

                    var fullDate = (id_month + 1) + "/" + id_date + "/" + id_year;

                    var today_date = new Date();
                    var today_year = today_date.getFullYear();
                    var today_month = today_date.getMonth();
                    var today_day = today_date.getDate();
                    var age = today_year - id_year;

                    if (today_month < (id_month - 1)) {
                        age--;
                    }
                    if (((id_month - 1) == today_month) && (today_day < id_date)) {
                        age--;
                    }

                    if (!((tempDate.getYear() == id.substring(0, 2)) && (id_month == id.substring(2, 4) - 1) && (id_date == id.substring(4, 6)))) {
                        error.append('<p>ID number does not appear to be authentic - date part not valid</p>');
                        correct = false;
                        document.getElementById("Identitynumspan").hidden = false;
                        document.getElementById("IdentityOrPassportNumbererror").innerHTML = "ID number does not appear to be authentic - date part not valid";
                    }
                    document.getElementById("Identitynumspan").hidden = true;
                    return valid;

                }
                else {
                    $('#IdentityOrPassportNumber').val('');
                    //alert("Please enter a valid 13 digit ID no.");

                    document.getElementById("Identitynumspan").hidden = false;
                    document.getElementById("IdentityOrPassportNumbererror").innerHTML = "Please enter a valid 13 digit ID no.";
                    //swal("Error!", "Please enter a valid 13 digit ID no.", "warning");
                    return false;
                }
            }
            catch (e) {
                //alert(bd+"Catch");
                return false;
            }
        }



        function Nationalitychange(element) {
            debugger
            $("#IdentityOrPassportNumber").prop("maxLength", 50);
            if (element.value == "Other") {
                document.getElementById("Identitynumspan").hidden = true;
                document.getElementById("DivNationalityOther").hidden = false;
                document.getElementById("DivExpiryPermit").hidden = false;
                document.getElementById("IdentityOrPassportNumber").setAttribute('onfocusout', '');
                document.getElementById("NationalityOther").required = true;
                document.getElementByName("ExpiryPermit").required = true;

            }
            else if (element.value == "South African National") {
                document.getElementById("Identitynumspan").hidden = true;
                $("#IdentityOrPassportNumber").prop("maxLength", 13);
                document.getElementById("DivNationalityOther").hidden = true;
                document.getElementById("DivExpiryPermit").hidden = true;
                document.getElementById("NationalityOther").required = false;
                document.getElementById("ExpiryPermit").required = false;
                document.getElementById("IdentityOrPassportNumber").setAttribute('onfocusout', 'ValidateRSAIDNo()');
                if (document.getElementById("IdentityOrPassportNumber").value != "") {
                    ValidateRSAIDNo();
                }
            }
            else {
                document.getElementById("Identitynumspan").hidden = true;
                document.getElementById("IdentityOrPassportNumber").setAttribute('onfocusout', '');
                document.getElementById("NationalityOther").required = false;
                document.getElementById("ExpiryPermit").required = true;
                document.getElementById("DivNationalityOther").hidden = true;
                document.getElementById("DivExpiryPermit").hidden = false;
            }
        }

        var isSame = "false"
        $(document).ready(function () {
            Nationalitychange(document.getElementById("Nationality"))
            var ExpiryPermit = new Pikaday({
                field: document.getElementById('ExpiryPermit'),
                format: 'YYYY/MM/DD',
                minDate: new Date(),
                toString(date, format) {
                    var today = date;
                    const day = ('0' + (today.getDate())).slice(-2);
                    const month = ('0' + (today.getMonth() +1)).slice(-2);
                    const year = today.getFullYear();
                
                    return `${year}-${month}-${day}`;
                }
            });

            var AppealDate = new Pikaday({
                field: document.getElementById('AppealDate'),
                format: 'YYYY/MM/DD HH:MM',
                maxDate: new Date(),
                toString(date, format) {
                    var today = new Date();
                    const day = ('0' + (date.getDate())).slice(-2);
                    const month = ('0' + (date.getMonth() + 1)).slice(-2);
                    const year = date.getFullYear();
                    const hour = today.getHours();
                    const min = ('0' + today.getMinutes()).slice(-2);
        
                    return `${year}-${month}-${day} ${hour}:${min}`;
                }
            });

