            $("#UploadTable tr").each(function (i, v) {
                debugger;
                TableData[i] = Array();
                $(this).find("div.col-md-6").each(function (ii, vv) {
                    debugger;
                    var r = $(this);
                    TableData[i][ii] = $(this).find("input[type='hidden']").val();

