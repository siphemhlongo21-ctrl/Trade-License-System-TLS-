        function Nationalitychange(element) {

            if (element.value == "Other") {
                document.getElementById("DivNationalityOther").hidden = false;
                document.getElementById("DivExpiryPermit").hidden = false;

                document.getElementById("DivNationalityOther").required = true;
                document.getElementById("DivExpiryPermit").required = true;
            }
            else if (element.value != "South African National") {
                document.getElementById("DivNationalityOther").hidden = true;
                document.getElementById("DivExpiryPermit").hidden = false;
                document.getElementById("DivNationalityOther").required = false;
                document.getElementById("DivExpiryPermit").required = true;
            }
            else {
                document.getElementById("DivNationalityOther").required = false;
                document.getElementById("DivExpiryPermit").required = false;
                document.getElementById("DivNationalityOther").hidden = true;
                document.getElementById("DivExpiryPermit").hidden = true;
            }
        }

