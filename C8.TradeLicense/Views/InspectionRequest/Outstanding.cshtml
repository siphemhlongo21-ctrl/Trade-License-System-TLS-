@using (Html.BeginForm(new { id = @id }))
{
    @Html.AntiForgeryToken()

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Inspection Outstanding - <span class="badge">@ViewBag.LicenseInspectionCount</span></h3>
        </div>
        <div class="table-responsive">
            <table class="table">
                <tr>
                    <th>
                        @Html.DisplayName("Client Name")
                    </th>
                    <th>
                        @Html.DisplayName("Department")
                    </th>
              
                    <th>
                        @Html.DisplayNameFor(model => model.Status.StatusName)
                    </th>
                
                    <th>
                        @Html.DisplayName("Actions")
                    </th>
                </tr>

                @foreach (var item in Model)
                {
                    
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client.Fullname)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Department.DepartmentName)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Status.StatusName)
                    </td>
                    @if (item.Status.StatusKey == "PendingLicenseInspection")
                    {
                    <td>
                        <a href="@Url.Action("Create","InspectionResponse", new {  id = item.InspectionRequestId })">
                            <i class="glyphicon glyphicon-plus" title="Add Responses"></i>
                            <span class="sr-only">Add Responses</span>
                        </a>
                        @*@Html.ActionLink(linkText: "Create Response", actionName: "Create", controllerName: "InspectionResponse", routeValues: new { id = item.InspectionRequestId }, htmlAttributes: new { @class = "btn btn-outline-warning" })*@
                    </td>
                    }
                    else if (item.Status.StatusKey != "AwaitingManagerResponse" && item.Status.StatusKey != "InspectionFailed")
                    {
                    <td>
                        <a href="@Url.Action("Edit","InspectionResponse", new { id = item.InspectionRequestId })">
                            <i class="glyphicon glyphicon-pencil" title="Edit Response"></i>
                            <span class="sr-only">Edit Response</span>
                        </a>
                        @*@Html.ActionLink(linkText: "Edit Response", actionName: "Edit", controllerName: "InspectionResponse", routeValues: new { id = item.InspectionRequestId }, htmlAttributes: new { @class = "btn btn-outline-warning" })*@

                    </td>
                        @*if (item.StatusId == 30)
                        {
                        <td >
                            @Html.ActionLink(linkText: "Edit Appeal", actionName: "Edit", controllerName: "InspectionAppeals", routeValues: new { id = item.InspectionRequestId }, htmlAttributes: new { @class = "btn btn-outline-warning" })

                        </td >
                        }
                        if (item.StatusId == 1035)
                        {
                           
                        }
                        else
                        {
                        <td >
                            @Html.ActionLink(linkText: "Add Appeal", actionName: "Create", controllerName: "InspectionAppeals", routeValues: new { InspectionRequestId = item.InspectionRequestId }, htmlAttributes: new { @class = "btn btn-outline-warning" })
                        </td >


                    }*@

                    }

                    <td>
                </tr>
                }

            </table>
        </div>
    </div>
       
    <div >
       
        @Html.ActionLink("Back to List","LicensePendingResponses", "InspectionResponse", null, new { @class = "btn btn-outline-primary" })
    </div>
}




