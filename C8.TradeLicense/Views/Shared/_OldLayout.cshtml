@using System.Web.Optimization
@using C8.TradeLicense.DataAccessLayer
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Trade License System 2016 - @ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/themes/base/css")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryvalidate")
    @Scripts.Render("~/bundles/jqueryui")

</head>
<body>
    <script>
        document.onkeydown = function (event) {

            if (!event) { /* This will happen in IE */
                event = window.event;
            }

            var keyCode = event.keyCode;

            if (keyCode == 8 &&
                ((event.target || event.srcElement).tagName != "TEXTAREA") &&
                ((event.target || event.srcElement).tagName != "INPUT")) {

                if (navigator.userAgent.toLowerCase().indexOf("msie") == -1) {
                    event.stopPropagation();
                } else {
                    alert("prevented");
                    event.returnValue = false;
                }

                return false;
            }
        };
    </script>
    <nav role="navigation" class="navbar navbar-inverse">
        <!-- Brand and toggle get grouped for better mobile display -->
        <div class="navbar-header">
            <button type="button" data-target="#navbarCollapse" data-toggle="collapse" class="navbar-toggle">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a id="tls" href="#" class="navbar-brand">TLS - @DateTime.Now.Year</a>
        </div>
        <!-- Collection of nav links, forms, and other content for toggling -->
        <div id="navbarCollapse" class="collapse navbar-collapse">
            <ul class="nav navbar-nav">
                <li class="active">@Html.ActionLink("Home", "Index", "Home")</li>
                @*@if(User.Identity.IsAuthenticated && User.IsInRole("Admin"))*@
                @if (User.Identity.IsAuthenticated && User.IsInRole("Clerk") || User.IsInRole("Administrator") || User.IsInRole("Licensing Manager")
                    || User.IsInRole("Inspector") || User.IsInRole("Chief Inspector"))
                {
                    if (User.IsInRole("Clerk") || User.IsInRole("Administrator"))
                    {
                        <li>@Html.ActionLink("Clients", "Index", "Client")</li>
                        <li>@Html.ActionLink("Businesses", "Index", "Business")</li>
                    }

                    if (User.IsInRole("Licensing Manager"))
                    {
                        <li>@Html.ActionLink("License Approval", "Index", "InspectionResponse")</li>
                    }

                    <li class="dropdown">
                        <a data-toggle="dropdown" class="dropdown-toggle" href="#">Licenses<b class="caret"></b></a>
                        <ul role="menu" class="dropdown-menu" style="width: auto">

                            <li>@Html.ActionLink("Approved Licenses", "ApprovedLicenses", "License")</li>
                            @*<li>@Html.ActionLink("Declined Licenses", "DeclinedLicenses", "License")</li>*@
                            <li>@Html.ActionLink("Pending License Applications", "Index", "License")</li>
                            <li>@Html.ActionLink("Revoked Licenses", "RevokedLicenses", "License")</li>
                            <li>@Html.ActionLink("Renew Licenses", "LicenseRenewal", "License")</li>
                            <li>@Html.ActionLink("Terminated License Applications", "TerminatedLicenses", "License")</li>
                            <li class="divider"></li>
                            <li>@Html.ActionLink("License Collection", "LicenseCollection", "License")</li>
                        </ul>
                    </li>
                }
                <!-- if (User.IsInRole("Inspectors") || User.IsInRole("Administrator")) -->
                @if (User.Identity.IsAuthenticated && User.IsInRole("Inspector") || User.IsInRole("Chief Inspector") || User.IsInRole("Administrator"))
                {
                    var db = new TradeLicenseDbContext();
                    var identityManager = new IdentityManager();
                    var user = identityManager.CurrentUser(User);
                    bool inspectorAssigned = db.DepartmentContacts.Any(dc => dc.UserId == user.UserId && dc.IsActive == true && dc.IsDeleted == false);

                    if (inspectorAssigned || User.IsInRole("Administrator"))
                    {
                        <li>@Html.ActionLink("Inspection Request", "Index", "InspectionRequest")</li>
                        <li>@Html.ActionLink("Inspection Response", "Index", "InspectionResponse")</li>

                    }
                    if (inspectorAssigned)
                    {
                        <li>@Html.ActionLink("Enquiries", "Index", "Enquiry")</li>
                    }
                }

                @if (User.IsInRole("Administrator"))
                {
                    <li class="dropdown">
                        <a data-toggle="dropdown" class="dropdown-toggle" href="#">Admin<b class="caret"></b></a>
                        <ul role="menu" class="dropdown-menu">
                            @*<li>@Html.ActionLink("Business Operations", "Index", "BusinessOperationType")</li>*@
                            <li>@Html.ActionLink("Type Of Businesses", "Index", "BusinessType")</li>
                            <li>@Html.ActionLink("Type Of Licenses", "Index", "LicenseType")</li>
                            <li>@Html.ActionLink("Type Of Documents", "Index", "DocumentType")</li>
                            <li>@Html.ActionLink("Document Checklist", "Index", "DocumentCheckList")</li>
                            <li>@Html.ActionLink("Documents", "Index", "Document")</li>
                            <li>@Html.ActionLink("Operation Structures", "Index", "OperationStructureType")</li>
                            <li>@Html.ActionLink("Title Deeds", "Index", "TitleDeedType")</li>
                            <li>@Html.ActionLink("Status", "Index", "Status")</li>
                            <li>@Html.ActionLink("Status Types", "Index", "StatusType")</li>
                            <li>@Html.ActionLink("Departments", "Index", "Department")</li>
                            <li>@Html.ActionLink("Department Contacts", "Index", "DepartmentContact")</li>
                            <li>@Html.ActionLink("Item Types", "Index", "ItemType")</li>
                            <li>@Html.ActionLink("Item Sub-Categories", "Index", "ItemSubCategory")</li>
                            <li>@Html.ActionLink("Regions", "Index", "Region")</li>
                            <li>@Html.ActionLink("Conditions", "Index", "Condition")</li>
                            <li>@Html.ActionLink("Item Conditions", "Index", "ItemCondition")</li>
                            <li class="divider"></li>
                            <li>@Html.ActionLink("Users", "Index", "User")</li>
                        </ul>
                    </li>
                }


            </ul>
            @Html.Partial("_LoginPartial")
        </div>
    </nav>

    <div class="container">
        @RenderBody()
        <hr>
        <div class="row">
            <div class="col-sm-12" align="center">
                <footer>
                    <p>© Copyright 2015 eThekwini Municipality</p>
                </footer>
            </div>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
