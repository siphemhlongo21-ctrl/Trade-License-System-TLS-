@model IEnumerable<C8.TradeLicense.Models.DocumentCheckList>
@*@model C8.TradeLicense.Models.LicenseDocuments*@
@*@using C8.TradeLicense.Models*@

<table class="table" style="align-items: center">
    <legend>Required Documents</legend>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.DocumentType.DocumentTypeName)
        </th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DocumentType.DocumentTypeName)
            </td>

        </tr>
    }
</table>

