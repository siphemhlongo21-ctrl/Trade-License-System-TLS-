<body class="body-custom mb-0">
    <div class="user-onboarding">
        <div class="container">
            <div class="container body-content">
                @RenderBody()
                
             
            </div>
        </div>
    </div>
    

    <script>
        $(document).ready(function () {

            if ('@Session["Message"]' == "Email Sent Successfully") {
                alert("Email Sent Successfully");
            }
            var sPath = window.location.pathname;
            var sPage = sPath.substring(sPath.lastIndexOf('/') + 1);
            $(".pmd-sidebar-nav").each(function () {
                $(this).find("a[href='" + sPage + "']").parents(".collapse").addClass("show");
                $(this).find("a[href='" + sPage + "']").parents(".collapse").prev('a.nav-link').addClass("active");
                $(this).find("a[href='" + sPage + "']").addClass("active");
            });

            $(".auto-update-year").html(new Date().getFullYear());
        });
    </script>
    <!-- login page sections show hide -->
    <script type="text/javascript">
        $(document).ready(function () {
     
            $('.app-list-icon li a').addClass("active");
            $(".login-for").click(function () {
                $('.login-card').hide()
                $('.forgot-password-card').show();
            });
            $(".signin").click(function () {
                $('.login-card').show()
                $('.forgot-password-card').hide();
            });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $(".login-register").click(function () {
                $('.login-card').hide()
                $('.forgot-password-card').hide();
                $('.register-card').show();
            });

            $(".register-login").click(function () {
                $('.register-card').hide()
                $('.forgot-password-card').hide();
                $('.login-card').show();
            });
            $(".forgot-password").click(function () {
                $('.login-card').hide()
                $('.register-card').hide()
                $('.forgot-password-card').show();
            });
            if("@ViewBag.IsError" == "1")
            {
                $('.login-card').hide()
                $('.forgot-password-card').hide();
                $('.register-card').show();
             
            }
        });
    </script>
    <!-- Scripts Ends -->
    <script>
        var FullName = null;
        var Email = null;
        var Phonenumber = null;
        var Password = null;
        $(document).ready(function () {
    
            $("#animat").hide();
            $("#alert").hide();
            $(".dropdown").hover(
                function () {
                    $('.dropdown-menu', this).stop(true, true).slideDown("fast");
                    $(this).toggleClass('open');
                },
                function () {
                    $('.dropdown-menu', this).stop(true, true).slideUp("fast");
                    $(this).toggleClass('open');
                }
            );



            $("#CreateAccount").click(function () {

                $("#animat").show();
                $("#CreateAccount").hide();
                FullName = $("#FullName").val();
                Email = $("#Email").val();
                Phonenumber = "0000000000";
                Password = $("#Password").val();

                var obj = {
                    "FullName": FullName,
                    "Email": Email,
                    "CellNo": Phonenumber,
                    "Password": Password

                };

                var settings = {
                    'cache': false,
                    'dataType': "jsonp",
                    "async": true,
                    "crossDomain": true,
                    "url": "http://10.10.7.14/GENERIC/configs/AddCustomerAccount.php",
                    "data": obj,
                    "method": "GET",
                    "headers": {
                        "accept": "application/json",
                        "Access-Control-Allow-Origin": "*"
                    }
                }

                $.ajax(settings).done(function (response) {
                    if (response == 1) {
                        $("#alert").show();
                        //$("#animat").hide();
                        //$("#CreateAccount").show();
                        //alert(response);
                    }
                });


            });
        });
    </script>
    <script>
        var Email = null;
        var Password = null;

        $(document).ready(function () {
         
            $("#animat").hide();
            $(".dropdown").hover(
                function () {
                    $('.dropdown-menu', this).stop(true, true).slideDown("fast");
                    $(this).toggleClass('open');
                },
                function () {
                    $('.dropdown-menu', this).stop(true, true).slideUp("fast");
                    $(this).toggleClass('open');
                }
            );


            $("#Login").click(function () {
                Email = $("#Email").val();
                Password = $("#Password").val();
                $("#animat").show();
                $("#Login").hide();
                var obj = {
                    "Email": Email,
                    "Password": Password

                };

                var settings = {
                    'cache': false,
                    'dataType': "jsonp",
                    "async": true,
                    "crossDomain": true,
                    "url": "http://10.10.7.14/GENERIC/configs/GetCustomerAccount.php",
                    "data": obj,
                    "method": "GET",
                    "headers": {
                        "accept": "application/json",
                        "Access-Control-Allow-Origin": "*"
                    }
                }

                $.ajax(settings).done(function (response) {
                    //alert(JSON.stringify(response));
                    if (response[0]) {
                        $.session.set('FullName', response[0].FullName);
                        $.session.set('Email', response[0].Email);
                        $.session.set('CellNo', response[0].CellNo);
                        $.session.set('USERID', response[0].id);
                        window.location.href = "USER/index.html";
                    } else {
                        $("#animat").hide();
                        $("#Login").show();
                    }
                    //$.session.set('DepartmentName', response[0].DepartmentName);

                });

            });
        });
    </script>
</body>
</html>
