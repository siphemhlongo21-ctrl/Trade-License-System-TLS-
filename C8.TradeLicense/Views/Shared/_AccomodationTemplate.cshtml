    var business = (Business)ViewData["Business"];
    var license = (License)ViewData["License"];
    var conditions = (IEnumerable<LicenseApplicationConditions>)ViewData["Conditions"] ?? Enumerable.Empty<LicenseApplicationConditions>();

    int totalConditions = conditions.Count();
    int displayed = Math.Min(9, totalConditions);



