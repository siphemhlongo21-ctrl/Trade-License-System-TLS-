@model C8.TradeLicense.Models.LicenseApplicationDetails
@using C8.TradeLicense.Models
@using Microsoft.Ajax.Utilities
@using C8.TradeLicense.DataAccessLayer;

@{
    ViewBag.Title = "Edit";
    var client = Model.CustomerDetails;
    var documentTypes = Model.BussinessDocuments;
    var documentsList = Model.ClientUploadList;
    var license = Model.LicenseDetails ;
    var issueDate = "None";
    var expiryDate = "None";
    var db = new TradeLicenseDbContext();
    if (license != null)
    {
        issueDate = license.LicenseIssueDateTime != null ? Convert.ToDateTime(license.LicenseIssueDateTime).ToShortDateString() : "Not issued";
        expiryDate = license.LicenseExpiryDate != null ? Convert.ToDateTime(license.LicenseExpiryDate).ToShortDateString() : "----";
    }

}

<style>
    .number {
        background-color: transparent !important;
        border: 1.5px solid white;
        border-radius: 50px;
        color: white !important;
    }

    .step-app > .step-steps > li > a {
        display: block;
        padding: 10px;
        color: white;
        background-color: #848484;
        text-decoration: none;
        border-right: 1px solid #fff;
    }

    legend {
        display: block;
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
        font-size: 25px;
        line-height: inherit;
        color: #333;
        border: 0;
        background-color: aliceblue;
        border-bottom: 1px solid #00d0ff;
    }

    .error {
        color: tomato;
    }

</style>

<script type="text/javascript">

    window.onload = $('#BusinessOperator').change();

    $(document).ready(function () {
        $("#OperatorTable").hide();
        $("#NewManger").hide();
        $("#newemployee").hide();
        $("#EmployeeTable").hide();

        var currentItemType = $("#ddlItemTypeName option:selected").text();
        if (currentItemType !== "Item 2") {
            $("#fingerprint_verification").hide();
        }

        var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(Model.ClientOustandingDocuments))';
        var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);
        var groupList = [];

        $.each(outstandingDocuments, function (index, value) {
            groupList.push('<li>' + value + '</li>');
        });

        if (groupList.length > 0) {
            $('#outstandingDocumentList').append(groupList.join(''));
            $('#documentAlert').show();
        }

    });
    function Setstreet(element) {


        var options = {};
        options.url = "/Search/StreetName";
        options.type = "GET";
        options.data = { "criteria": $(element).val() };
        options.dataType = "json";
        options.success = function (data) {


            $("#dataliststreet").empty();
            for (var i = 0; i < data.length; i++) {




                $("#dataliststreet").append("<option value='" +
                data[i].STRNAME + "'></option>");

            }
        };
        $.ajax(options);

    }
    function findcity(datalist, element, sub) {

        if ($("#" + sub).val() != undefined) {
            document.getElementById(sub).value = "";
        }

        var city = $(element).val();
        SetSub('', datalist, city)
    }
    function getPCode(element, Pcode) {
        if ($("#" + Pcode).val() != undefined) {
            document.getElementById(Pcode).value = 0;
        }

        var options = {};
        options.url = "/Search/Postalcode";
        options.type = "GET";
        options.data = { "criteria": criteria };
        options.dataType = "json";
        options.success = function (data) {


            if (data.PostalCode != null) {
                document.getElementById(Pcode).value = data.PostalCode;
            }
        };

        $.ajax(options);
    }
    function SetSub(element, datalist, city) {
        if (city == '') {
            criteria = $(element).val()

        }
        else {
            criteria = ""

        }

        var options = {};
        options.url = "/Search/GetSubList";
        options.type = "GET";
        options.data = { "criteria": criteria, "city": city };
        options.dataType = "json";
        options.success = function (data) {


            $('#' + datalist).empty();
            for (var i = 0; i < data.length; i++) {



                $('#' + datalist).append("<option value='" +
                data[i].SUBURB + "'></option>");
            }
        };
        $.ajax(options);
    }
    function Setcity(element, datalist) {


        var options = {};
        options.url = "/Search/GetCityList";
        options.type = "GET";
        options.data = { "criteria": $(element).val() };
        options.dataType = "json";
        options.success = function (data) {


            $('#' + datalist).empty();
            for (var i = 0; i < data.length; i++) {



                $('#' + datalist).append("<option value='" +
                data[i].DISTRICT + "'></option>");
            }
        };
        $.ajax(options);
    }

    $("#ClientId").val('@client.ClientId');
    var currentItemType = $("#ddlItemTypeName option:selected").text();
    if (currentItemType !== "Item 2") {
        $("#fingerprint_verification").hide();
    }

    /// This Function executes when BusinessOperator is changed
