    $(document).ready(function () {
        var currentItemType = $("#ddlItemTypeName option:selected").text();
        if (currentItemType !== "Item 2") {
            $("#fingerprint_verification").hide();
        }

        var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(ViewBag.OustandingDocuments))';
        var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);
        var groupList = [];

        $("#ItemTypeId").change(function () {        
            var itemType = $("#ItemTypeId option:selected").text();

            if (itemType === "Item 2") {
                $("#fingerprint_verification").show();
                $("#itemTypeValue").val("Item2");
            }
            else {
                $("#fingerprint_verification").hide();
                $("#itemTypeValue").val("Item1");
            }
        });

        $.each(outstandingDocuments, function (index, value) {
            groupList.push('<li>' + value + '</li>');
        });

        if (groupList.length > 0) {
            $('#outstandingDocumentList').append(groupList.join(''));
            $('#documentAlert').show();
        }

    });
</script>
@{
    ViewBag.Title = "Edit";
    var documentTypes = (IEnumerable<Document>)ViewData["Documents"];
    var documentsList = (IEnumerable<FileUpload>)ViewData["UploadList"];
    var license = (License)ViewData["LicenseInfo"];
    var issueDate = "None";
    var expiryDate = "None";
    var db = new TradeLicenseDbContext();
    if (license != null)
    {
        issueDate = license.LicenseIssueDateTime != null ? Convert.ToDateTime(license.LicenseIssueDateTime).ToShortDateString() : "Not issued";
        expiryDate = license.LicenseExpiryDate != null ? Convert.ToDateTime(license.LicenseExpiryDate).ToShortDateString() : "----";
    }
   
}

@if (license == null || license.LicenseExpiryDate < DateTime.Now.AddDays(1))
{
    <div class="alert-warning">
        <p>
            <h2>No business license or license may be expired!</h2>
        </p>
    </div>
}
else
{
   
    <div class="alert alert-info">
        <p>
            License Type:  @license.LicenseType.LicenseTypeName
            <br />
            License Issue Date: @issueDate

            <br />
            Next Renewal Date: @expiryDate

        </p>
    </div>
}


