@using System.ComponentModel
@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models
@using System.Linq
@model C8.TradeLicense.Models.LicenseApplicationDetails

@{
    ViewBag.Title = "Create";
    var client = Model.CustomerDetails;
    var businesses =Model.ClientBusinessesList;
    var documentTypes = Model.BussinessDocuments;
    var documentsList = Model.ClientUploadList;
    var BusinessManager = Model.BusinessMangers;
    var BusinessEmployee =Model.BusinessEmployees;
    var db = new TradeLicenseDbContext();
    var Employee = "";
    var Operaotor = "";

    try
    {
        if (ViewBag.EmployeeTableData != null)
        {
            Employee = ViewBag.EmployeeTableData;
        }
        if (ViewBag.OperatorTableData != null)
        {
            Operaotor = ViewBag.OperatorTableData;
        }
    }
    catch (Exception e) { }
}

<style>
    .number {
        background-color: transparent !important;
        border: 1.5px solid white;
        border-radius: 50px;
        color: white !important;
    }

    .step-app > .step-steps > li > a {
        display: block;
        padding: 10px;
        color: white;
        background-color: #848484;
        text-decoration: none;
        border-right: 1px solid #fff;
    }

    legend {
        display: block;
        width: 100%;
        padding: 0;
        margin-bottom: 20px;
        font-size: 25px;
        line-height: inherit;
        color: #333;
        border: 0;
        background-color: aliceblue;
        border-bottom: 1px solid #00d0ff;
    }

    .error {
        color: tomato;
    }
</style>

<script type="text/javascript">
    window.onload= $('#BusinessOperator').change();
    var OperatorTableDataArray = new Array();
    var EmployeeTableDataArray = new Array();
    var EditEmployeeTableDataArray = new Array()
	var EditOperatorTableDataArray = new Array();

	var employees = $("#operators").val();
	if (employees != "" && employees != undefined) {
		var employeeList = employees.split('*');
		for(var i = 0; employeeList.length-1; i++)
		{
			var record = employeeList[i].split(',');
			$("#EmployeeTable").append("<tr><td>" + record[0] + "</td><td>" + record[1] + "</td>" + "<td>" + record[2] + "</td><td>" + record[3] + "</td><td>" + record[4] + "</td><td>" + record[5] + "</td>" + "<td>" + record[6] + "</td><td>" + record[7] + "</td></tr>");

		}
	}


    function Setstreet(element) {


        var options = {};
        options.url = "/Search/StreetName";
        options.type = "GET";
        options.data = { "criteria": $(element).val() };
        options.dataType = "json";
        options.success = function (data) {


            $("#dataliststreet").empty();
            for (var i = 0; i < data.length; i++) {




                $("#dataliststreet").append("<option value='" +
                data[i].STRNAME + "'></option>");

            }
        };
        $.ajax(options);

    }
    function checkaddress() {
        var isChecked = $('#isSame').is(':checked');
        if (isChecked) {




            var v1 = $("#PostalAddress1").val();
            if (v1.length != 0) {
                $("#ResidentialAddress1").val($("#PostalAddress1").val());

                $('#ResidentialAddress1').prop("disabled", true);
                $("#ResidentialAddress1").css("color", "black");
                $("#ResidentialAddress1-error").attr("hidden", true);

            }
            var v2 = $("#PostalAddress2").val();
            if (v2.length != 0) {
                $("#ResidentialAddress2").val($("#PostalAddress2").val());

                $('#ResidentialAddress2').prop("disabled", true);
                $("#ResidentialAddress2").css("color", "black");
                $("#ResidentialAddress2-error").attr("hidden", true);

            }
            var v3 = $("#PostalAddress3").val();

            if (v3.length != 0) {
                $("#ResidentialAddress3").val($("#PostalAddress3").val());

                $('#ResidentialAddress3').prop("disabled", true);
                $("#ResidentialAddress3").css("color", "black");
                $("#ResidentialAddress3-error").attr("hidden", true);

            }
            var v4 = $("#PostalAddressCode").val();

            if (v4.length == 4) {


                $("#ResidentialAddressCode").val($("#PostalAddressCode").val());

                $('#ResidentialAddressCode').prop("disabled", true);
                $("#ResidentialAddressCode").css("color", "black");
                $("#ResidentialAddressCode-error").attr("hidden", true);
            }

        } else {
            $('#ResidentialAddress1').prop("disabled", false);
            $('#ResidentialAddress2').prop("disabled", false);
            $('#ResidentialAddress3').prop("disabled", false);
            $('#ResidentialAddressCode').prop("disabled", false);
            $("#ResidentialAddress1").val("");
            $("#ResidentialAddress2").val("");
            $("#ResidentialAddress3").val("");
            $("#ResidentialAddressCode").val("");
            $('#postalAddress').show();
        }
    }
    function Selfempoyed(value) {

        if (value == "Owner") {


            document.getElementById("NameOfEmployer").required = false;
            document.getElementById("EmployerResidentialAddress1").required = false;
            document.getElementById("EmployerResidentialAddress2").required = false;
            document.getElementById("EmployerResidentialAddress3").required = false;
            document.getElementById("EmployerResidentialAddressCode").required = false;

            document.getElementById("lblNameOfEmployer").className = "control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddress1").className = "control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddress2").className = "control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddress3").className = "control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddressCode").className = "control-label col-md-2";


        } else {

            document.getElementById("lblNameOfEmployer").className = "required-field control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddress1").className = "required-field control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddress2").className = "required-field control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddress3").className = "required-field control-label col-md-2";
            document.getElementById("lblEmployerResidentialAddressCode").className = "required-field control-label col-md-2";
            document.getElementById("NameOfEmployer").required = true;
            document.getElementById("EmployerResidentialAddress1").required = true;
            document.getElementById("EmployerResidentialAddress2").required = true;
            document.getElementById("EmployerResidentialAddress3").required = true;
            document.getElementById("EmployerResidentialAddressCode").required = true;

            $("#NameOfEmployer").removeAttr("readonly");
            $("#EmployerResidentialAddress1").removeAttr("readonly");
            $("#EmployerResidentialAddress2").removeAttr("readonly");
            $("#EmployerResidentialAddress3").removeAttr("readonly");
            $("#EmployerResidentialAddressCode").removeAttr("readonly");

            $("#NameOfEmployer").val("");
            $("#EmployerResidentialAddress1").val("");
            $("#EmployerResidentialAddress2").val("");
            $("#EmployerResidentialAddress3").val("");
            $("#EmployerResidentialAddressCode").val("");
        }
    }

    $(document).ready(function () {
        $("#OperatorTable").hide();
        $("#NewManger").hide()
        $("#newemployee").hide();
        $("#EmployeeTable").hide();
        var Id = 0;
        document.getElementById("BusinessEmployeeId").value = Id;
        document.getElementById("BusinessMangerId").value = Id;
        document.getElementById("OperatorTableData").value = "";
        document.getElementById("EmployeeTableData").value = "";
        $("#ClientId").val('@client.ClientId');
        var currentItemType = $("#ddlItemTypeName option:selected").text();
        if (currentItemType !== "Item 2") {
            $("#fingerprint_verification").hide();
        }

        $("#ddlBusinessType").change(function () {
            var businessType = $("#ddlBusinessType option:selected").text();

            if (businessType == "PTY(LTD)") {
                $("#pty").show();
            }
            else {
                $("#pty").hide();
            }

        });

        $("#ddlItemTypeName").change(function () {
            var itemType = $("#ddlItemTypeName option:selected").text();
            var itemTypeId = $("#ddlItemTypeName option:selected").val();

            if (itemType === "Item 2") {
                $("#fingerprint_verification").show();
                $("#itemTypeValue").val("Item2");
            }
            else {
                $("#fingerprint_verification").hide();
                $("#itemTypeValue").val("Item1");
            }


            $.ajax({
                type: 'POST',
                url: '@Url.Action("ReloadItemSubCategory", "Business")',
                dataType: 'json',
                data: { itemTypeId: itemTypeId },
                success: function (data) {

                    var dropdown = $("#ddlItemSubCategoryName");
                    dropdown.empty(); // Clear existing options

                    // Add a default option
                    dropdown.append($('<option></option>').val('').text('---Select Sub Category---'));

                    // Add options based on the data received
                    $.each(data, function (index, item) {
                        dropdown.append($('<option></option>').val(item.ItemSubCategoryId).text(item.ItemSubCategoryName));
                    });
                }
            });

        });

        $('#BusinessOperator').change(function () {

            var selection = $('option:selected', this).text();

            Selfempoyed(selection)
            // alert($('option:selected', this).text());
            if (selection == "Owner") {
                @*alert(@client.Fullname);*@
                $("#NameOfBusinessOperator").val('@client.Fullname');
                $("#OperatorIdentityOrPassportNumber").val('@client.IdentityOrPassportNumber');
                $("#OperatorResidentialAddress1").val('@client.ResidentialAddress1');
                $("#OperatorResidentialAddress2").val('@client.ResidentialAddress2');


                $("#OperatorResidentialAddress3").val('@client.ResidentialAddress3');
                $("#OperatorResidentialAddressCode").val('@client.ResidentialAddressCode');

                $("#NameOfBusinessOperator").attr("readonly", "readonly");
                $("#OperatorIdentityOrPassportNumber").attr("readonly", "readonly");
                $("#OperatorResidentialAddress1").attr("readonly", "readonly");





            } else {

                $("#NameOfBusinessOperator").removeAttr("readonly");
                $("#OperatorIdentityOrPassportNumber").removeAttr("readonly");
                $("#OperatorResidentialAddress1").removeAttr("readonly");
                $("#OperatorResidentialAddress2").removeAttr("readonly");
                $("#OperatorResidentialAddress3").removeAttr("readonly");
                $("#OperatorResidentialAddressCode").removeAttr("readonly");

                $("#NameOfBusinessOperator").val("");
                $("#OperatorIdentityOrPassportNumber").val("");
                $("#OperatorResidentialAddress1").val("");
                $("#OperatorResidentialAddress2").val("");
                $("#OperatorResidentialAddress3").val("");
                $("#OperatorResidentialAddressCode").val("");
                $('span.number:eq(4)').html(5);
                $("ul.step-steps li:contains('Employee Details')").show();


            }
        });

        $('#isOwnerOperator').change(function () {
            var isChecked = $(this).is(':checked');
            if (isChecked) {

                $("#NameOfBusinessOperator").val('@client.Fullname');
                $("#OperatorIdentityOrPassportNumber").val('@client.IdentityOrPassportNumber');
                $("#OperatorResidentialAddress1").val('@client.ResidentialAddress1');
                $("#OperatorResidentialAddress2").val('@client.ResidentialAddress2');


                $("#OperatorResidentialAddress3").val('@client.ResidentialAddress3');
                $("#OperatorResidentialAddressCode").val('@client.ResidentialAddressCode');

            } else {
                $("#NameOfBusinessOperator").val("");
                $("#OperatorIdentityOrPassportNumber").val("");
                $("#OperatorResidentialAddress1").val("");
                $("#OperatorResidentialAddress2").val("");
                $("#OperatorResidentialAddress3").val("");
                $("#OperatorResidentialAddressCode").val("");

            }
        });

        $('#isSame').change(function () {
            var isChecked = $(this).is(':checked');
            if (isChecked) {
                isSame = "true";


                var v1 = $("#PostalAddress1").val();

				if (v1.length != 0) {
					$("#ResidentialAddress1").val($("#PostalAddress1").val());

					$('#ResidentialAddress1').prop("disabled", true);
					$("#ResidentialAddress1").css("color", "black");
					$("#ResidentialAddress1-error").attr("hidden", true);

				}
				var v2 = $("#PostalAddress2").val();
				if (v2.length != 0) {
					$("#ResidentialAddress2").val($("#PostalAddress2").val());

					$('#ResidentialAddress2').prop("disabled", true);
					$("#ResidentialAddress2").css("color", "black");
					$("#ResidentialAddress2-error").attr("hidden", true);

				}
				var v3 = $("#PostalAddress3").val();

				if (v3.length != 0) {
					$("#ResidentialAddress3").val($("#PostalAddress3").val());

					$('#ResidentialAddress3').prop("disabled", true);
					$("#ResidentialAddress3").css("color", "black");
					$("#ResidentialAddress3-error").attr("hidden", true);

				}
				var v4 = $("#PostalAddressCode").val();

				if (v4.length == 4) {


					$("#ResidentialAddressCode").val($("#PostalAddressCode").val());

					$('#ResidentialAddressCode').prop("disabled", true);
					$("#ResidentialAddressCode").css("color", "black");
					$("#ResidentialAddressCode-error").attr("hidden", true);
				}
            }
            else {
                $('#ResidentialAddress1').prop("disabled", false);
                $('#ResidentialAddress2').prop("disabled", false);
                $('#ResidentialAddress3').prop("disabled", false);
                $('#ResidentialAddressCode').prop("disabled", false);
                $("#ResidentialAddress1").val("");
                $("#ResidentialAddress2").val("");
                $("#ResidentialAddress3").val("");
                $("#ResidentialAddressCode").val("");
                $('#postalAddress').show();

				$("#ResidentialAddressCode-error").attr("hidden", false);
				$("#ResidentialAddress1-error").attr("hidden", false);
				$("#ResidentialAddress3-error").attr("hidden", false);
				$("#ResidentialAddress2-error").attr("hidden", false);
            }
        });

        $(document).ready(function () {
            var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(ViewBag.OustandingDocuments))';
            var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);

            var groupList = [];

            $.each(outstandingDocuments, function (index, value) {
                groupList.push('<li>' + value + '</li>');
            });

            if (groupList.length > 0) {
                $('#outstandingDocumentList').append(groupList.join(''));
                $('#documentAlert').show();
            }

        });
    });


    // ResidentialAddress is the same as PostalAddress checkbox
    $(function () {
        $('#isSame').change(function () {
            var isChecked = $(this).is(':checked');
            if (isChecked) {
                isSame = "true";




				var v1 = $("#PostalAddress1").val();
				if (v1.length != 0) {
					$("#ResidentialAddress1").val($("#PostalAddress1").val());

					$('#ResidentialAddress1').prop("disabled", true);
					$("#ResidentialAddress1").css("color", "black");
					$("#ResidentialAddress1-error").attr("hidden", true);

				}
				var v2 = $("#PostalAddress2").val();
				if (v2.length != 0) {
					$("#ResidentialAddress2").val($("#PostalAddress2").val());

					$('#ResidentialAddress2').prop("disabled", true);
					$("#ResidentialAddress2").css("color", "black");
					$("#ResidentialAddress2-error").attr("hidden", true);

				}
				var v3 = $("#PostalAddress3").val();

				if (v3.length != 0) {
					$("#ResidentialAddress3").val($("#PostalAddress3").val());

					$('#ResidentialAddress3').prop("disabled", true);
					$("#ResidentialAddress3").css("color", "black");
					$("#ResidentialAddress3-error").attr("hidden", true);

				}
				var v4 = $("#PostalAddressCode").val();

				if (v4.length == 4) {


					$("#ResidentialAddressCode").val($("#PostalAddressCode").val());

					$('#ResidentialAddressCode').prop("disabled", true);
					$("#ResidentialAddressCode").css("color", "black");
					$("#ResidentialAddressCode-error").attr("hidden", true);
				}
            }
            else {
                $('#ResidentialAddress1').prop("disabled", false);
                $('#ResidentialAddress2').prop("disabled", false);
                $('#ResidentialAddress3').prop("disabled", false);
                $('#ResidentialAddressCode').prop("disabled", false);
                $("#ResidentialAddress1").val("");
                $("#ResidentialAddress2").val("");
                $("#ResidentialAddress3").val("");
                $("#ResidentialAddressCode").val("");
                $('#postalAddress').show();

				$("#ResidentialAddressCode-error").attr("hidden", false);
				$("#ResidentialAddress1-error").attr("hidden", false);
				$("#ResidentialAddress3-error").attr("hidden", false);
				$("#ResidentialAddress2-error").attr("hidden", false);
            }
        });

    });
    $(function () {
        $("#pty").hide();
        //$("#accordion1").hide();
    });



</script>


@using (Html.BeginForm("Create", "Business", FormMethod.Post, new { enctype = "multipart/form-data", @id = "businessForm" }))
{
    @Html.AntiForgeryToken()

    if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <a class="close" data-dismiss="alert">×</a>
            <strong>@TempData["Success"].ToString()</strong>
            <ul id="outstandingDocumentList"></ul>
        </div>
    }
    else
    {
        if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <a class="close" data-dismiss="alert">×</a>
                <h4 class="alert-heading">Warning!</h4>
                @TempData["Error"].ToString()
            </div>
        }
        <div class="alert alert-danger" id="existBError" hidden>
            <a class="close" data-dismiss="alert">×</a>
            <h4 class="alert-heading">Warning!</h4>
            There is already a registered business with the same name on the system!
        </div>
        @*if (ViewBag.OustandingDocuments.Count > 0)
            {
                <div class="alert alert-warning">
                    <a class="close" data-dismiss="alert">×</a>
                    <strong>Outstanding Documents</strong>
                    <ul id="outstandingDocumentList"></ul>
                </div>
            }*@
    }
    <h2 align="center">New Business </h2>
    <input type="text" value="@Employee" id="operators" hidden />
    <input type="text" value="@Operaotor" id="employees" hidden />

    <div id="demo">

        @*Tabs on form*@
        <div class="step-app">
            <ul class="step-steps">
                <li><a href="#step1"><span class="number">1</span>Customer Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                <li><a href="#step2"><span class="number">2</span>Business Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                <li><a href="#step3"><span class="number">3</span>Operator Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                <li id="Listep4"><a href="#step4"> <span class="number">4</span>Employee Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                <li><a href="#step5"> <span class="number">5</span>Registered Business</a></li>
            </ul>
            <div class="step-content">

                <div class="step-tab-panel" id="step1" align="center">
                    @Html.Partial("~/Views/Shared/_ClientPartial.cshtml", client)

                </div>
                <div class="step-tab-panel" id="step2" align="center">
                    <legend align="center">Business Details</legend>
                    <div class="form-horizontal" align="left">

                        <div class="form-group" hidden="hidden">
                            @Html.LabelFor(model => model.CustomerDetails.ClientId, new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.TextBoxFor(model => model.CustomerDetails.ClientId, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.CustomerDetails.ClientId)
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.BusinessDetails.ProposedTradeName, new { @class = "control-label col-md-2 required-field" })
                            <div class="col-md-4">
                                @Html.TextBoxFor(model => model.BusinessDetails.ProposedTradeName, new { @class = "form-control", @required = "required" })
                                @Html.ValidationMessageFor(model => model.BusinessDetails.ProposedTradeName)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.BusinessDetails.BusinessTypeId, new { @class = "control-label col-md-2 required-field" })
                            <div class="col-md-4">
                                @Html.DropDownListFor(model => model.BusinessDetails.BusinessTypeId, Model.BusinessTypeList, "--Select Business Type--", new { @class = "form-control", id = "ddlBusinessType", @required = "required" })
                                @Html.ValidationMessageFor(model => model.BusinessDetails.BusinessTypeId)
                            </div>
                        </div>
                        <div class="form-group" id="pty">
                            @Html.LabelFor(model => model.BusinessDetails.KnownAs, new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.TextBoxFor(model => model.BusinessDetails.KnownAs, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.BusinessDetails.KnownAs)
                            </div>
                        </div>
                        <hr />
                        <div class="form-group">
                            <button type="button" class="btn btn-sm btn-primary" style="margin-left:95px;" id="ButtonaddLocationPlus" onclick="ButtonAddLocation()"><i class="glyphicon glyphicon-globe"></i> GIS</button>

                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.BusinessDetails.PostalAddress1, new { @class = "control-label col-md-2 required-field" })
                            <div class="col-md-3">
                                @Html.TextBoxFor(model => model.BusinessDetails.PostalAddress1, new { @id = "PostalAddress1", @class = "form-control", @required = "required", Onchange = "checkaddress()" })
                                @Html.ValidationMessageFor(model => model.BusinessDetails.PostalAddress1)
                            </div>
                        </div>
                        <div class="form-group">
                            @*city*@
                            @Html.LabelFor(model => model.BusinessDetails.PostalAddress3, new { @class = "control-label col-md-2 required-field" })
                            <div class="col-md-3">
                                @Html.TextBoxFor(model => model.BusinessDetails.PostalAddress3, new { @id = "PostalAddress3", @class = "form-control", @required = "required", name = "datalistCity", Onchange = "checkaddress()", list = "datalistCity" })
                                <datalist id="datalistCity">
                                    <option value="Select">
                                </datalist>
                                @Html.ValidationMessageFor(model => model.BusinessDetails.PostalAddress3)
                            </div>
                        </div>
                        <div class="form-group">
                            @*sub*@
                            @Html.LabelFor(model => model.BusinessDetails.PostalAddress2, new { @class = "control-label col-md-2 required-field" })
                            <div class="col-md-3">
                                @Html.TextBoxFor(model => model.BusinessDetails.PostalAddress2, new { @id = "PostalAddress2", @class = "form-control", @required = "required", name = "datalistsub", Onchange = "checkaddress()", list = "datalistsub" })
                                <datalist id="datalistsub">
                                    <option value="Select">
                                </datalist>
                                @Html.ValidationMessageFor(model => model.BusinessDetails.PostalAddress2)
                            </div>
                        </div>



                        <div class="form-group">
                            @Html.LabelFor(model => model.BusinessDetails.PostalAddressCode, new { @class = "control-label col-md-2 required-field" })
                            <div class="col-md-1">
                                @Html.TextBoxFor(model => model.BusinessDetails.PostalAddressCode, new { @id = "PostalAddressCode", @class = "form-control", @required = "required", maxlength = 4, MinLength = 4, @onkeypress = "return blockSpecialCharandnums(event)", Onchange = "checkaddress()" })
                                @Html.ValidationMessageFor(model => model.BusinessDetails.PostalAddressCode)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.BusinessDetails.ResidentialShopOrUnitNumber, new { @class = "control-label col-md-2 " })
                            <div class="col-md-1">
                                @Html.TextBoxFor(model => model.BusinessDetails.ResidentialShopOrUnitNumber, new { @class = "form-control", maxlength = 4, @onkeypress = "return blockSpecialCharandnums(event)" })
                                @Html.ValidationMessageFor(model => model.BusinessDetails.ResidentialShopOrUnitNumber)
                            </div>
                        </div>
                        <hr />
                        <div class="form-group">
                            <button type="button" class="btn btn-sm btn-primary" style="margin-left:95px;" id="ButtonaddLocationPlusPostal" onclick="ButtonAddLocations()"><i class="glyphicon glyphicon-globe"></i> GIS</button>

                        </div>
                        <div id="postalAddress">
                            <div class="form-group">
                                @Html.LabelFor(model => model.BusinessDetails.ResidentialAddress1, new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-3">
                                    @Html.TextBoxFor(model => model.BusinessDetails.ResidentialAddress1, new { @id = "ResidentialAddress1", @class = "form-control", @required = "required" })

                                    @Html.ValidationMessageFor(model => model.BusinessDetails.ResidentialAddress1)
                                </div>
                                <div>
                                    @Html.Label("Same as postal address", new { style = "font-style: italic; font-weight: normal; color: Red" })
                                    @Html.CheckBoxFor(model => model.BusinessDetails.SameAs, new { id = "isSame", title = "Check if business address is same as postal address" })
                                    @*@Html.CheckBox("isSame", new { id = "isSame", title = "Check if business address is same as postal address" })*@
                                </div>
                            </div>

                            <div class="form-group">
                                @*city*@
                                @Html.LabelFor(model => model.BusinessDetails.ResidentialAddress3, new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-3">
                                    @Html.TextBoxFor(model => model.BusinessDetails.ResidentialAddress3, new { @id = "ResidentialAddress3", @class = "form-control", @required = "required", name = "datalistRCity", list = "datalistRCity" })

                                    <datalist id="datalistRCity">
                                        <option value="Select">
