                <div class="step-tab-panel" id="step4">
                    <legend align="center">Employee Details</legend>
                    @Html.Partial("~/Views/Shared/_BusinessEmployeePartial.cshtml")
                </div>
                <div class="step-tab-panel" id="step5">
                    <legend align="center"> Customer Registered Business</legend>



                    @if (Request.HttpMethod == "POST" && documentsList.ToList().Count > 0)
                    {
                        <table class="table-bordered">
                            <tr>
                                <th>Document Type</th>
                                <th>FileName</th>
                                <th>Created Date</th>
                            </tr>
                            @foreach (var item in documentsList)
                            {
                                <tr>
                                    <td style="padding-right: 10px">@item.Document.DocumentName </td>
                                    <td style="padding-right: 10px"><a target="_blank" href="@C8.TradeLicense.Keys.ActionLinkKeys.SharePointDownload@item.FilePath">@item.FileName</a></td>
                                    <td style="padding-right: 10px">@item.Uploadeddate</td>
                                    @{
                                        if (Request.HttpMethod != "POST")
                                        {
                                            if (Model.BusinessDetails.BusinessStatusId == db.Status.Where(s => s.StatusKey == "BusinessApproved").Select(s => s.StatusId).FirstOrDefault())
                                            {
                                                <td style="padding-right: 10px">
                                                    <a href="@Url.Action("Delete", new { id = @item.DocumentId })">
                                                        <i class="glyphicon glyphicon-remove" title="Delete"></i>
                                                        <span class="sr-only">Delete</span>
                                                    </a>
                                                </td>
                                            }

                                        }
                                    }

                                </tr>

                            }
                        </table>
                    }



                    @if (businesses.Any())
                    {

                        <h5>Client Registered Businesses</h5>

                        @Html.Partial("~/Views/Shared/_ClientBusinessPartial.cshtml")


                    }
                    else
                    {
                        if (TempData["norecord"] != null)
                        {
                            <div class="alert-danger">
                                <a class="close" data-dismiss="alert">×</a>
                                @TempData["norecord"].ToString()
                            </div>
                        }
                    }
                </div>

            </div>
            <div class="step-footer">
                <div align="left" class="col-lg-3">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
                </div>
                <div align="center" class="col-lg-6">
                    <button data-direction="prev" class="btn btn-outline-primary">Previous</button>
                    <button data-direction="next" class="btn btn-outline-primary">Next</button>
                    <button data-direction="finish" class="btn btn-outline-success">Finish</button>
                </div>
                <div class="col-lg-3" align="right">
                    <input type="submit" value="Save" id="submitBusiness" class="btn btn-default" hidden />

                    &nbsp;
                    @{
                        if (Request.HttpMethod == "POST")
                        {

                            var hasLicense = db.Licenses.Where(l => l.BusinessId == Model.BusinessDetails.BusinessId && l.LicenseExpiryDate > DateTime.Now).Select(l => l.BusinessId).FirstOrDefault();
                            if (Model.BusinessDetails.BusinessStatusId == db.Status.Where(s => s.StatusKey == "BusinessApproved").Select(s => s.StatusId).FirstOrDefault()
                                && hasLicense == null)
                            {
                                <a class="btn btn-default" href="@Url.Action("Create", "License", new { id = Model.BusinessDetails.BusinessId })">
                                    <span class="font-icon-group"></span>Add License
                                </a>
                            }
                        }
                    }
                </div>
            </div>

