<div class="panel panel-default" id="collapseOne">
    <div class="panel-heading">
        <h3 class="panel-title">Registered Businesses - <span class="badge">@ViewBag.BusinessCount</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.First().Client.IdentityOrPassportNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Client.Fullname)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().ProposedTradeName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().BusinessType.BusinessTypeName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().OperationStructureTypeId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().ResidentialAddress)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().BusinessStatus.StatusName)
                </th>
                <th>Action</th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client.IdentityOrPassportNumber)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Client.Fullname)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProposedTradeName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BusinessType.BusinessTypeName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OperationStructureType.OperationStructureTypeName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ResidentialAddress)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BusinessStatus.StatusName)
                    </td>
                    <td style="width: 20px">
                           @{


                               if (item.BusinessStatusId == db.Status.Where(s => s.StatusKey == StatusKeys.BusinessApproved).Select(s => s.StatusId).FirstOrDefault())
                               {
                                   if (User.IsInRole("System Admin") || User.IsInRole("Licensing Manager") || User.IsInRole("Licensing Administrator"))
                                   {
                                <a href="@Url.Action("Edit", new { id = item.BusinessId })">
                                    <i class="glyphicon glyphicon-pencil" title="Edit"></i>
                                    <span class="sr-only">Edit</span>
                                </a>
                                   }
                               }
                               else
                               {
                                <a href="@Url.Action("Edit", new { id = item.BusinessId })">
                                    <i class="glyphicon glyphicon-pencil" title="Edit"></i>
                                    <span class="sr-only">Edit</span>
                                </a>
                               }

                        }

                       
   

                        <a href="@Url.Action("Details", new { id = item.BusinessId })">
                            <i class="glyphicon glyphicon-list" title="View Details"></i>
                            <span class="sr-only">Details</span>
                        </a>
                   @{
                       if (ViewBag.CanAction)
                       {
                    <a href="@Url.Action("Delete", new {id = item.BusinessId})">
                        <i class="glyphicon glyphicon-remove" title="Delete" style="color:red"></i>
                    </a>
                            <span class="sr-only">Delete</span>
                }
                        }
                        @{

                var hasLicense = db.Licenses.Where(l => l.BusinessId == item.BusinessId && l.IsDeleted == false && l.IsActive).Select(l => l.BusinessId).FirstOrDefault(); /*&& (l.IsDeleted == false && l.IsActive)*/
                if (item.BusinessStatusId == db.Status.Where(s => s.StatusKey == StatusKeys.BusinessApproved).Select(s => s.StatusId).FirstOrDefault())  /* && hasLicense == null*/
                {
                    <a href="@Url.Action("Create", "License", new {id = item.BusinessId})">
                        <i class="glyphicon glyphicon-plus" title="Add License"></i>
                        <span class="sr-only">Add License</span>
                    </a>
                }

                        }
                    </td>
                </tr>
            }

        </table>
        <div align="center" style="-moz-box-shadow: dodgerblue">
            Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
            @Html.PagedListPager(Model, page => Url.Action("Index",new { page, selectedSearch = ViewBag.selecetedSearch, currentFilter = ViewBag.CurrentFilter }))
            @*Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", new { page = 1 })">
                            <i class="glyphicon glyphicon-fast-backward" title="Go to first Page"></i>
                        </a>
                        @Html.Raw(" ");
                        <a href="@Url.Action("Index", new { page = Model.PageNumber - 1 })">
                            <i class="glyphicon glyphicon-backward" title="Previous"></i>
                        </a>
                    }
                    else
                    {
                        <i class="glyphicon glyphicon-fast-backward" title="Go to first Page"></i>
                        @Html.Raw(" ");
                        <i class="glyphicon glyphicon-backward" title="Previous"></i>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", new { page = Model.PageNumber + 1 })">
                            <i class="glyphicon glyphicon-forward" title="Next"></i>
                        </a>
                        @Html.Raw(" ");
                        <a href="@Url.Action("Index", new { page = Model.PageCount })">
                            <i class="glyphicon glyphicon-fast-forward" title="Go to last Page"></i>
                        </a>

                    }
                    else
                    {
                        <i class="glyphicon glyphicon-forward" title="Next"></i>
                        @Html.Raw(" ")
                        <i class="glyphicon glyphicon-fast-forward" title="Go to last Page"></i>
                    }*@
        </div>
    </div>
</div>

