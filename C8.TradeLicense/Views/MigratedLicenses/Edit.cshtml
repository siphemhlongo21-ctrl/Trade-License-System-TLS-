        function PayInSlipCheck() {
            initLoadHoldOn("Verifying..Please Wait");
            addToArray(document.getElementById("PayinslipNumber").value);

            var PayinslipNumbers = document.getElementById("PayinslipNumberData").value;

            $.ajax
    ({

        url: '/License/PayInSlipCheck',
        data: JSON.stringify({ PayinslipNumbers: PayinslipNumbers,licenseId : @license.MLicenseId.ToString() }),
        method: 'post',
        dataType: 'json',
        contentType: 'application/json;charset=utf-8',
        success: function (result) {
            if (result != "Error" && result != "[]") {

                if (result == "exits") {
                    document.getElementById("Erroralert").hidden = false;
                    document.getElementById("error2").innerHTML = "Payin Slip number has been used";
                    clear();
                }
                else if( result =="Invalid")
                {
                    document.getElementById("Erroralert").hidden = false;
                    document.getElementById("error2").innerHTML = "Payin Slip number incorrect";

                    clear();
                }
                else
                {
                    QueryPayInSlip();
                }


            }
            else {
                document.getElementById("Erroralert").hidden = false;
                document.getElementById("error2").innerHTML = "Please try again";

                clear();
            }
        },
        error: function (xhr, textStatus, error) {
            document.getElementById("Erroralert").hidden = false;
            document.getElementById("error2").innerHTML = error;
            clear();
        },
    })
        };

        function AddEntry(result) {

            var jR = JSON.parse(result);
            document.getElementById("PayinslipNumber").value = "";
            $("#tblPayment").find("tr:not(:first)").remove();

            for (var i = 0; i < jR.length; i++) {
                var row = $("<tr />")
                $("#tblPayment").append(row);
                row.append($("<td>" + jR[i].PAYINSLIP_NO + "</td>"));
                row.append($("<td>" + jR[i].CUST_ACCT_NO + "</td>"));
                row.append($("<td>" + jR[i].SERVICE_UNIT + "</td>"));
                row.append($("<td>" + jR[i].REQUEST_NO + "</td>"));
                row.append($("<td>" + jR[i].PAYINSLIP_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].ALLOCATED_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].PAID_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].BALANCE_UNALLOCATED_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].PAYINSLIP_DATE + "</td>"));
                row.append($("<td>" + jR[i].PAID_DATE+ "</td>"));

            }
            HoldOn.close();
        }

