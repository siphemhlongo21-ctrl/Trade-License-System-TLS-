        function LoadPayInSlip() {


            $.ajax
    ({

        url: '/License/LoadPayInSlip',
        data: JSON.stringify({licenseId : @license.MLicenseId.ToString() }),
        method: 'post',
        dataType: 'json',
        contentType: 'application/json;charset=utf-8',
        success: function (result) {
            if (result != "Error" && result != "[]") {

                if ("@Model.Exits" == "1") {
                    document.getElementById("Erroralert").hidden = false;
                    document.getElementById("error2").innerHTML = "Payin Slip number Has been used";
                    clear();
                }
                AddEntry(result);
            }
            else {
                document.getElementById("Erroralert").hidden = false;
                document.getElementById("error2").innerHTML = "Payin Slip number incorrect";

                clear();
            }
        },
        error: function (xhr, textStatus, error) {
            document.getElementById("Erroralert").hidden = false;
            document.getElementById("error2").innerHTML = error;
            clear();
        },
    })
        };
        function QueryPayInSlip() {

            //addToArray(document.getElementById("PayinslipNumber").value);

            var PayinslipNumbers = document.getElementById("PayinslipNumberData").value;

            $.ajax
    ({

        url: '/License/QueryPayInSlip',
        data: JSON.stringify({ PayinslipNumbers: PayinslipNumbers,licenseId : @license.MLicenseId.ToString() }),
        method: 'post',
        dataType: 'json',
        contentType: 'application/json;charset=utf-8',
        success: function (result) {
            if (result != "Error" && result != "[]") {
                document.getElementById("Erroralert").hidden = true;
                AddEntry(result);
            }
            else {
                document.getElementById("Erroralert").hidden = false;
                document.getElementById("error2").innerHTML = "Payin Slip number incorrect";

                clear();
            }
        },
        error: function (xhr, textStatus, error) {
