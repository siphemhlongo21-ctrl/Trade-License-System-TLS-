@model C8.TradeLicense.Models.LicenseApplicationDetails
@using C8.TradeLicense.Keys;
@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models
@{
    ViewBag.Title = "Migrated License";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var BusinessEmployee = Model.BusinessEmployees;
    var BusinessManager = Model.BusinessMangers;
    var client =Model.MigratedClient;
    var business = Model.MigratedBusiness;
    var licenseType = Model.LicenseTypeDetails;
    var itemType = Model.ItemTypeDetails;
    var clientDocuments = Model.ClientOustandingDocuments;
    var BussinessDocuments = Model.BussinessOustandingDocuments;
    var BussinessList = Model.BussinessUploadList;
    var ClientList =Model.ClientUploadList;
    var license = Model.MigratedLicense;
    var db = new TradeLicenseDbContext();
}
@if (TempData["Error2"] != null)
{
    <div class="alert alert-danger">
        <strong>Error</strong> @TempData["Error2"].ToString()
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <strong>Error</strong> @TempData["Error"].ToString()
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <a class="close" data-dismiss="alert">×</a>
        <strong>@TempData["Success"].ToString()</strong>
        <ul id="outstandingDocumentList"></ul>
    </div>
}
<div class="alert alert-danger" hidden="hidden" id="Erroralert">
    <a class="close" data-dismiss="alert">×</a>

    <strong><p id="error2">error</p></strong>
</div>
<div id="errorResponse" class="alert alert-warning" style="display:none;">
</div>
