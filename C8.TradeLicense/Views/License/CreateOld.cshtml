@model C8.TradeLicense.Models.License
@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models
@{
    ViewBag.Title = "Create License";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{

    var client = (Client)ViewData["ClientData"];
    var business = (Business)ViewData["BusinessData"];
    var licenseType = (LicenseType)ViewData["LicenseType"];
    var itemType = (ItemType)ViewData["ItemType"];
}
<style>
    .btn-outline-success {
        border: 1px solid black;
        background-color: white;
        color: black;
    }
</style>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Create License</h3>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Create", "License", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">

                <div>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                            <span class="sr-only">Success: </span>
                            @TempData["Success"].ToString()

                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                            <span class="sr-only">Error: </span>
                            @TempData["Error"].ToString()
                        </div>
                    }
                </div>
                <div>
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info">
                            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                            <span class="sr-only">Info: </span>
                            @TempData["Info"].ToString()
                        </div>
                    }
                </div>
                <div class="panel-group" id="accordion">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title">
                                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                                    Client and Business Information
                                </a>
                            </h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse in">
                            <div class="panel-body">
                                @Html.Partial("~/Views/Shared/_ClientPartial.cshtml")
                            </div>
                            <div class="panel-body">
                                @Html.Partial("~/Views/Shared/_BusinessPartial.cshtml")
                            </div>
                        </div>
                    </div>
                </div>
                @*Accordion*@

                @Html.ValidationSummary(true)
                <div>
                    @Html.HiddenFor(model => model.ClientId, new { Value = @client.ClientId })
                </div>
                <div>
                    @Html.HiddenFor(model => model.BusinessId, new { Value = @business.BusinessId })
                </div>
                <div>
                    @Html.HiddenFor(model => model.ItemTypeId, new { Value = @itemType.ItemTypeId })
                </div>
                <div>
                    @Html.HiddenFor(model => model.LicenseTypeId, new { Value = @licenseType.LicenseTypeId })
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">License</h3>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                            <dl class="dl-horizontal">
                                <dt>
                                    License Type :
                                </dt>
                                <dd>
                                    <div class="col-md-3">
                                        @Html.Label(licenseType.LicenseTypeName)

                                    </div>
                                </dd>
                                <dt>
                                    Region :
                                </dt>
                                <dd>
                                    <div class="col-md-3">

                                        @Html.DropDownList("RegionId", "Select Region")
                                        @*@Html.
                                            DropDownList("ddlregion", new SelectList(ViewBag.Regions, "Text", "Value"), new { @id = "ddlRegion" })*@
                                        @Html.ValidationMessageFor(model => model.RegionId)
                                    </div>
                                </dd>
                                <dt>
                                    Item Type :
                                </dt>
                                <dd>
                                    <div class="col-md-3">
                                        @Html.Label(itemType.ItemTypeName)

                                    </div>
                                </dd>
                                <dt>
                                    Item Sub-Category :

                                </dt>
                                <dd>
                                    <div class="col-md-3">
                                        @Html.DropDownList("ItemSubCategoryId", "Select Sub Category")
                                        @Html.ValidationMessageFor(model => model.ItemSubCategoryId)
                                    </div>
                                </dd>
                                <dt>
                                    Item Condition :
                                </dt>
                                <dd>
                                    <div class="col-md-3">
                                        @Html.DropDownList("ItemConditionId", "Select Item Condition")
                                        @Html.ValidationMessageFor(model => model.ItemConditionId)
                                    </div>
                                </dd>

                                <dt>
                                    Inspections Done ? :
                                </dt>
                                <dd>
                                    <div class="col-md-3">
                                        @Html.CheckBox("inspectionsCompleteCheck")
                                    </div>
                                </dd>
                            </dl>

                            @*License Type : *@
                            @*  @Html.LabelFor(model => model.LicenseTypeId, "License Type", new { @class = "control-label col-md-2" })*@
                            @*   <div class="col-md-10">
                                @Html.Label(licenseType.LicenseTypeName)*@
                            @*@Html.DropDownList("LicenseTypeId", "Select License Type")
                                @Html.ValidationMessageFor(model => model.LicenseTypeId)*@
                            @*</div>*@

                        </div>
                        @*  <div class="form-group">
                            Item Type : *@
                        @*  @Html.LabelFor(model => model.LicenseTypeId, "License Type", new { @class = "control-label col-md-2" })*@
                        @* <div class="col-md-10">
                            @Html.Label(itemType.ItemTypeName)*@
                        @*@Html.DropDownList("LicenseTypeId", "Select License Type")
                            @Html.ValidationMessageFor(model => model.LicenseTypeId)*@
                        @*    </div>

                            </div>*@
                        <div class="form-group">
                            <div class="col-md-10">
                            </div>

                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10" align="right">
                        <input type="submit" value="Create" class="btn btn-outline-success" />
                    </div>
                </div>
            </div>
        }
        <div>
        </div>
    </div>
</div>