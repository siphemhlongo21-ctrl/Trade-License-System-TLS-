        function PayInSlipCheck() {
            initLoadHoldOn("Verifying..Please Wait");

            TableDataTemp.push(document.getElementById("PayinslipNumber").value);


            var data = TableDataTemp.join();
            document.getElementById("PayinslipTableData").value = data;

            var PayinslipNumbers = document.getElementById("PayinslipTableData").value;
            var Exist = '0';

            for (var i = 0; i < TableDataTemp.length; i++) {
                var name = TableDataTemp[i];
                for (var ii = 0; ii < TableData.length; ii++) {
                    var name2 = TableData[ii];
                    for (var iii = 0; iii < name2.length; iii++) {
                        var list = name2[iii];
                        var ret = list.replace('*', '');
                        if (ret == name) {
                            Exist = '1';
                            document.getElementById("Erroralert").hidden = false;
                            document.getElementById("error2").innerHTML = "Duplicate Payin slip numbers not allowed ";
                            TableDataTemp = [];
                            break;


                        }
                    }
                }

            }
            if (Exist == '0') {


                $.ajax
        ({

            url: '/License/PayInSlipCheck',
            data: JSON.stringify({ PayinslipNumbers: PayinslipNumbers }),
            method: 'post',
            dataType: 'json',
            contentType: 'application/json;charset=utf-8',
            success: function (result) {

                if (result.success) {

                    document.getElementById("Erroralert").hidden = true;

                    if (result.msg == "exits") {

                        document.getElementById("Erroralert").hidden = false;
                        document.getElementById("error2").innerHTML = "Payin Slip number has been used \nLicense Number: " + result.licensenum;
                        document.getElementById("PayinslipNumber").value = "";
                        document.getElementById("PayinslipTableData").value = "";

                        TableDataTemp = [];
                        HoldOn.close();

                    }
                    else if (result.msg == "Invalid") {
                        document.getElementById("Erroralert").hidden = false;
                        document.getElementById("error2").innerHTML = "Payin Slip number incorrect";
                        document.getElementById("PayinslipNumber").value = "";
                        document.getElementById("PayinslipTableData").value = "";

                        TableDataTemp = [];
                        HoldOn.close();

                    }
                    else {

                        insRow();
                    }



                }
                else {
                    document.getElementById("Erroralert").hidden = false;
                    document.getElementById("error2").innerHTML = "Please try again";


                }
            },
            error: function (xhr, textStatus, error) {
                document.getElementById("Erroralert").hidden = false;
                document.getElementById("error2").innerHTML = error;

            },
        })
            }

            HoldOn.close();
        };

