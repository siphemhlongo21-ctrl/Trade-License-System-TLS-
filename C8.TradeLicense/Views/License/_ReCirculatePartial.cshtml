@model C8.TradeLicense.ViewModels.ReCirculateVM

@using (Html.BeginForm("SaveReCirculation",
                       "License",
                       FormMethod.Post,
                       new { id = "reCirculateForm" }))
{
    @Html.HiddenFor(x => x.InspectionRequestId)

    <div class="form-group">

        <label>Assign To Department Manager</label>

        @Html.DropDownListFor(x => x.NewInspectorId,
                 Model.Inspectors,
                 "-- Select Department Manager --",
                 new { @class = "form-control" })

    </div>

    <div class="form-group">

        <label>Reason</label>

        @Html.TextAreaFor(x => x.Reason,
                 new
                 {
                     @class = "form-control",
                     rows = 4
                 })

    </div>

    <button type="submit"
            class="btn btn-success">
        Save Re-Allocation
    </button>
}
