    <script type="text/javascript">

       function ToggleOtherDiv() {
        var optionSelected = $("#ItemSubCategoryId option:selected").text();
        if (optionSelected == "Other") {
            $("#OtherDiv").show();
        } else {
            $("#OtherItemSubCategory").val("");
            $("#OtherDiv").hide();
        }
    }

    // Load Sub Categories
    function LoadSubCategories(itemTypeId) {
        var dropdown = $("#ItemSubCategoryId");
        if (!itemTypeId) {
            dropdown.html('<option value="">Select Sub Category</option>');
            return;
        }

        $.ajax({
            url: '@Url.Action("GetSubCategoriesByItemType", "License")',
            type: 'GET',
            data: { itemTypeId: itemTypeId },
            success: function (data) {
                dropdown.empty().append('<option value="">Select Sub Category</option>');
                $.each(data, function (i, item) {
                    dropdown.append($('<option></option>').val(item.Value).html(item.Text));
                });
                ToggleOtherDiv();
            }
        });
    }

    // Load Item Conditions
    function LoadItemConditions(itemTypeId) {
        var dropdown = $("#ItemConditionId");
        if (!itemTypeId) {
            dropdown.html('<option value="">Select Item Condition</option>');
            return;
        }

        $.ajax({
            url: '@Url.Action("GetItemConditionsByItemType", "License")',
            type: 'GET',
            data: { itemTypeId: itemTypeId },
            success: function (data) {
                dropdown.empty().append('<option value="">Select Item Condition</option>');
                $.each(data, function (i, item) {
                    dropdown.append($('<option></option>').val(item.Value).html(item.Text));
                });
            }
        });
    }

    // ==================== Main Ready Function ====================
    $(document).ready(function () {

        $("#OtherDiv").hide();

        $("#ItemTypeId").change(function () {
            var itemTypeId = $(this).val();
            LoadSubCategories(itemTypeId);
            LoadItemConditions(itemTypeId);
        });

        // Initial load if Item Type is already selected
        var initialType = $("#ItemTypeId").val();
        if (initialType && initialType > 0) {
            LoadSubCategories(initialType);
            LoadItemConditions(initialType);
        }
    });





