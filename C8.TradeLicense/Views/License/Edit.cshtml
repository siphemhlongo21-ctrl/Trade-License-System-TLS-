@model C8.TradeLicense.Models.License

@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models
@{
    ViewBag.Title = "Edit License";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{

    var client = (Client)ViewData["ClientData"];
    var business = (Business)ViewData["BusinessData"];
    var licenseType = (LicenseType)ViewData["LicenseType"];
    var itemType = (ItemType)ViewData["ItemType"];
    var documentTypes = (IEnumerable<Document>)ViewData["Documents"];
    var documentsList = (IEnumerable<FileUpload>)ViewData["UploadList"];
    var license = (License)ViewData["LicenseInfo"];
    var db = new TradeLicenseDbContext();
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />

    <link rel="icon" type="image/png" href="assets/img/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="assets/img/favicon-32x32.png" sizes="32x32">

    <title>Trading License</title>

    <style>
        .number {
            background-color: transparent !important;
            border: 1.5px solid white;
            border-radius: 50px;
            color: white !important;
        }

        .step-app > .step-steps > li > a {
            display: block;
            padding: 10px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
        }

        legend {
            display: block;
            width: 100%;
            padding: 0;
            margin-bottom: 20px;
            font-size: 25px;
            line-height: inherit;
            color: #333;
            border: 0;
            background-color: aliceblue;
            border-bottom: 1px solid #00d0ff;
        }
           .error {
        color: tomato;
    }
    </style>
</head>


<br />
<br />
<br />
<body class="disable_transitions sidebar_main_open sidebar_main_swipe">
    <script>
            $(document).ready(function () {
                var currentItemType = $("#ddlItemTypeName option:selected").text();
                $("#ClientId").val('@client.ClientId');
        if (currentItemType !== "Item 2") {
            $("#fingerprint_verification").hide();
        }

        var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(ViewBag.OustandingDocuments))';
        var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);
        var groupList = [];

        $.each(outstandingDocuments, function (index, value) {
            groupList.push('<li>' + value + '</li>');
        });

        if (groupList.length > 0) {
            $('#outstandingDocumentList').append(groupList.join(''));
            $('#documentAlert').show();
        }

    });
    </script>

    @using (Html.BeginForm("Edit", "License", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
  

        <div id="demo">
            <div class="step-app">
                <ul class="step-steps">
                    <li><a href="#step1"><span class="number">1</span>License Holders Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step2"><span class="number">2</span>Business Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step3"><span class="number">3</span>Documentation <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step4"> <span class="number">4</span>License Details<span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step5"> <span class="number">5</span>Payment</a></li>
                   
                </ul>
                <div class="step-content">
                    <div class="step-tab-panel" id="step1" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_ClientPartial.cshtml")
                        <br>
                        <br>
                        <br>
                        <br>
                    </div>
                    <div class="step-tab-panel" id="step2" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_BusinessPartial.cshtml")
                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step3">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Business Documents</legend>


                        @if (documentsList.Any())
                        {
                            <strong>Uploaded Documents</strong>

                            <table class="table-bordered">
                                <tr>
                                    <th>Document Type</th>
                                    @* <th>FileName</th>*@
                                    <th>Created Date</th>
                                </tr>
                                @foreach (var item in documentsList)
                                {
                                    <tr>
                                        <td style="padding-right: 10px">@item.Document.DocumentName </td>
                                        @*   <td style="padding-right: 10px">@Html.ActionLink(item.FileName, "Download", "Client", new { id = item.FileUploadId, file = item.FileName, clientId = Model.ClientId }, htmlAttributes: null)</td>*@
                                        <td style="padding-right: 10px">@item.CreatedDateTime</td>

                                    </tr>

                                }
                            </table>
                        }


                        @if (ViewBag.OustandingDocuments.Count > 0)
                        {
                            <strong>Outstanding Documents</strong>
                            <ul id="outstandingDocumentList"></ul>
                            <br />
                            @Html.Partial("~/Views/Shared/_UploadPartial.cshtml", documentTypes)

                        }
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step4">
                        <br />
                        <br />
                        <br />
                        <legend align="center">License Details</legend>
                        @Html.HiddenFor(model => model.LicenseId)
                   
                        @Html.HiddenFor(model => model.ItemTypeId)
                        @Html.HiddenFor(model => model.StatusId)
                      
                        <div class="form-group" hidden="hidden">
                            @Html.LabelFor(model => model.ClientId, new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.TextBoxFor(model => model.ClientId, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.ClientId)
                            </div>
                        </div>
                        <dl class="dl-horizontal">
                            <dt>
                                License Type :
                            </dt>
                            <dd>
                                <div class="col-md-3">
                                    @Html.Label(licenseType.LicenseTypeName)
                                    <div hidden="hidden">
                                        @Html.Editor("LicenseTypeId", new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.Editor("BusinessID", new { htmlAttributes = new { @class = "form-control" } })
                                    </div>

                                </div>
                            </dd>
                            <dt>
                                Region :
                            </dt>
                            <dd>
                                <div class="col-md-3">

                                    @Html.DropDownList("RegionId", null, "Select Region", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.RegionId)
                                </div>
                            </dd>
                            <dt>
                                Item Type :
                            </dt>
                            <dd>
                                <div class="col-md-3">
                                    @Html.Label(itemType.ItemTypeName)
                                    @Html.Hidden(itemType.ItemTypeId.ToString(),new { htmlAttributes = new { name = "ItemTypeId",id= "ItemTypeId", @class = "form-control" } })

                                </div>
                            </dd>
                            <dt>
                                Item Sub-Category :

                            </dt>
                            <dd>
                                <div class="col-md-3">
                                    @Html.DropDownList("ItemSubCategoryId", null, "Select Sub Category", new { @class = "form-control  required-field" })
                                    @Html.ValidationMessageFor(model => model.ItemSubCategoryId)
                                </div>
                            </dd>
                            <dt>
                                Item Condition :
                            </dt>
                            <dd>
                                <div class="col-md-3">
                                    @Html.DropDownList("ItemConditionId", null, "Select Item Condition", new { @class = "form-control  required-field" })
                                    @Html.ValidationMessageFor(model => model.ItemConditionId)
                                </div>
                            </dd>

                            <dt hidden="hidden"> 
                                Inspections Done ? :
                            </dt>
                            <dd  hidden="hidden">
                                <div class="col-md-3">
                                    @Html.CheckBox("inspectionsCompleteCheck")
                                </div>
                            </dd>
                        </dl>
                        <div class="form-group" hidden>
                            <div class="col-md-offset-2 col-md-10" align="right">
                                <input type="submit" id="createLicense" value="Create" class="btn btn-outline-success" />
                            </div>
                        </div>
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step5">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Payment Details</legend>
                        <div>


                            <div class="panel-group" id="accordion">
                                <div class="panel panel-default">

                                    <div id="collapseOne" class="panel-collapse collapse in">
                                        <div class="panel-body">

                                       

                                            <table class="table">

                                                <tr>

                                                    <th>
                                                        @Html.DisplayName("Pay in slip Number")
                                                    </th>
                                                   
                                                    <th>
                                                        @Html.DisplayName("Customer Account Number")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Service Unit")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Request Number")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Pay in slip Amount")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Allocated Amount")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Paid Amount")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Unallocated Amount")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Pay In Slip Date")
                                                    </th>
                                                    <th>
                                                        @Html.DisplayName("Paid Date")
                                                    </th>


                                                </tr>

                                                @foreach (var item in @ViewBag.payment)
                                                {
                                                    <tr>
                                                        <td>
                                                            @item.PAYINSLIP_NO
                                                        </td>
                                                       
                                                        <td>
                                                            @item.CUST_ACCT_NO
                                                        </td>
                                                        <td>
                                                            @item.SERVICE_UNIT
                                                        </td>
                                                        <td>
                                                            @item.REQUEST_NO
                                                        </td>
                                                        <td>
                                                            @item.PAYINSLIP_AMOUNT
                                                        </td>
                                                        <td>
                                                            @item.ALLOCATED_AMOUNT
                                                        </td>
                                                        <td>
                                                            @item.PAID_AMOUNT
                                                        </td>
                                                        <td>
                                                            @item.BALANCE_UNALLOCATED_AMOUNT
                                                        </td>
                                                        <td>
                                                            @item.PAYINSLIP_DATE 
                                                        </td>
                                                        <td>
                                                            @item.PAID_DATE
                                                        </td>





                                                    </tr>
                                                }

                                            </table>




                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>




                    </div>


                    

                    
                   

                </div>
                
                <div class="step-footer">
                    <div align="left" class="col-lg-3">
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                    <div align="center" class="col-lg-6">
                        <button data-direction="prev" class="btn btn-outline-primary">Previous</button>
                        <button data-direction="next" class="btn btn-outline-primary">Next</button>
                        <button data-direction="finish" class="btn btn-outline-success">Finish</button>
                    </div>
                   
                </div>
            </div>
        </div>
    }
