@model C8.TradeLicense.ViewModels.DepartmentCirculationVM
@using C8.TradeLicense.Keys;
@{
    ViewBag.Title = "Edit License";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{

    var client = Model.CustomerDetails;
    var business = Model.BusinessDetails;
    var documentsList = Model.ClientUploadList;
    var license = Model.LicenseDetails;
    var circulationHistory = Model.DepartmentCirculationHistoryVM;

}

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />

    <link rel="icon" type="image/png" href="assets/img/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="assets/img/favicon-32x32.png" sizes="32x32">

    <title>Trading License</title>

    <style>
        .number {
            background-color: transparent !important;
            border: 1.5px solid white;
            border-radius: 50px;
            color: white !important;
        }

        .step-app > .step-steps > li > a {
            display: block;
            padding: 10px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
        }

        legend {
            display: block;
            width: 100%;
            padding: 0;
            margin-bottom: 20px;
            font-size: 25px;
            line-height: inherit;
            color: #333;
            border: 0;
            background-color: aliceblue;
            border-bottom: 1px solid #00d0ff;
        }

        .error {
            color: tomato;
        }
    </style>
</head>


<br />
<br />
<br />
<body class="disable_transitions sidebar_main_open sidebar_main_swipe">
    <script>
            $(document).ready(function () {
                var currentItemType = $("#ddlItemTypeName option:selected").text();
                $("#ClientId").val('@client.ClientId');
        if (currentItemType !== "Item 2") {
            $("#fingerprint_verification").hide();
        }

        var jsonOustandingDocumentList = '@Html.Raw(Json.Encode(Model.ClientOustandingDocuments))';
        var outstandingDocuments = JSON.parse(jsonOustandingDocumentList);
        var groupList = [];

        $.each(outstandingDocuments, function (index, value) {
            groupList.push('<li>' + value + '</li>');
        });

        if (groupList.length > 0) {
            $('#outstandingDocumentList').append(groupList.join(''));
            $('#documentAlert').show();
        }

    });
    </script>

    @using (Html.BeginForm("Departmentcirculation", "License", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                    <span class="sr-only">Success: </span>
                    @TempData["Success"].ToString()
                </div>
            }
        </div>
        <div>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                    <span class="sr-only">Error: </span>
                    @TempData["Error"].ToString()
                </div>
            }
        </div>
        <div class="alert alert-danger" hidden="hidden" id="Erroralert">
            <a class="close" data-dismiss="alert">×</a>

            <strong><p id="error2">error</p></strong>
        </div>
        <div>
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">
                    <a class="close" data-dismiss="alert">×</a>
                    <strong>Note!</strong>
                    @TempData["Info"].ToString()
                </div>
            }
        </div>

        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.LicenseDetails.LicenseId)
        @Html.HiddenFor(model => model.LicenseDetails.RegionId)
        @Html.HiddenFor(model => model.LicenseDetails.ApplicationDateTime)
        @Html.HiddenFor(model => model.LicenseDetails.LicenseTypeId)
        @Html.HiddenFor(model => model.LicenseDetails.ItemTypeId)
        @Html.HiddenFor(model => model.LicenseDetails.ItemConditionId)
        <div hidden="hidden">
            @Html.EditorFor(model => model.LicenseDetails.LicenseNumber, new { Value = Model.LicenseDetails.LicenseNumber })
        </div>
        <div>
            @Html.HiddenFor(model => model.CustomerDetails.ClientId, new { Value = @client.ClientId })
        </div>
        <div>
            @Html.HiddenFor(model => model.BusinessDetails.BusinessId, new { Value = @business.BusinessId })
        </div>

        <div id="demo">
            <div class="step-app">
                <ul class="step-steps">
                    <li><a href="#step1"><span class="number">1</span>License Holders Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step2"><span class="number">2</span>Business Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step3"><span class="number">3</span>Documentation <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step4"> <span class="number">4</span>License Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step5"> <span class="number">5</span>Payment <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step6"> <span class="number">6</span>Department Circulation History <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step7"> <span class="number">7</span>Department Circulation</a></li>

                </ul>
                <div class="step-content">
                    <div class="step-tab-panel" id="step1" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_ClientPartial.cshtml",client)
                        <br>
                        <br>
                        <br>
                        <br>
                    </div>
                    <div class="step-tab-panel" id="step2" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_BusinessPartial.cshtml",business)
                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step3" align="center">
                        <br />
                        @if (documentsList.Any())
                        {

                            <table class="table-bordered">
                                <tr>
                                    <th>Document Type</th>
                                    <th>FileName</th>
                                    <th>Created Date</th>
                                    <th>Comments</th>
                                </tr>
                                @foreach (var item in documentsList)
                                {
                                    <tr>
                                        <td style="padding-right: 10px" class="required-field">@item.Document.DocumentName </td>
                                           <td style="padding-right: 10px"><a target="_blank" href="@C8.TradeLicense.Keys.ActionLinkKeys.SharePointDownload@item.FilePath">@item.FileName</a></td>
                                        <td style="padding-right: 10px">@item.Uploadeddate</td>
                                        <td style="padding-right: 10px">@item.Comments</td>


                                    </tr>

                                }


                            </table>

                        }
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step4" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_LicencePartial.cshtml",license)
                        <br />
                        <br />
                        <br />
                        <br />
                        @Html.HiddenFor(model => model.LicenseDetails.ItemSubCategoryId)
                    </div>
                    <div class="step-tab-panel" id="step5">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Payment Details</legend>
                        <div>
                            <div class="panel-group" id="accordion">
                                <div class="panel panel-default">
                                    <div id="collapseOne" class="panel-collapse collapse in">
                                        <div class="panel-body">
                                   
                                            <div class="panel-group" id="accordion">
                                                <div class="panel panel-default">
                                                    <div id="collapseOne" class="panel-collapse collapse in">
                                                        <div class="panel-body">
                                                            <table class="table" id="tblPayment">
                                                                <thead>
                                                                    <tr>
                                                                        <th>
                                                                            @Html.DisplayName("Pay in slip Number")
                                                                        </th>

                                                                        <th>
                                                                            @Html.DisplayName("Customer Account Number")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Service Unit")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Request Number")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Pay in slip Amount")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Allocated Amount")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Paid Amount")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Unallocated Amount")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Pay In Slip Date")
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayName("Paid Date")
                                                                        </th>


                                                                    </tr>
                                                                </thead>
                                                                <tbody id="tblPaymentbody">
                                                                    @foreach (var item in Model.PaymentLicenses)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @item.PAYINSLIP_NO
                                                                            </td>

                                                                            <td>
                                                                                @item.CUST_ACCT_NO
                                                                            </td>
                                                                            <td>
                                                                                @item.SERVICE_UNIT
                                                                            </td>
                                                                            <td>
                                                                                @item.REQUEST_NO
                                                                            </td>
                                                                            <td>
                                                                                @item.PAYINSLIP_AMOUNT
                                                                            </td>
                                                                            <td>
                                                                                @item.ALLOCATED_AMOUNT
                                                                            </td>
                                                                            <td>
                                                                                @item.PAID_AMOUNT
                                                                            </td>
                                                                            <td>
                                                                                @item.BALANCE_UNALLOCATED_AMOUNT
                                                                            </td>
                                                                            <td>
                                                                                @item.PAYINSLIP_DATE
                                                                            </td>
                                                                            <td>
                                                                                @item.PAID_DATE
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="step-tab-panel" id="step6">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_DepartmentcirculationHistoryPartial.cshtml", circulationHistory)
                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step7">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Department List</legend>
                        <div>
                            <div class="form-group">
                                @Html.Label("Department", new { @class = "control-label col-md-2" })
                                <div class="col-md-3">
                                    @Html.DropDownList("DepartmentList", new SelectList(ViewBag.DepartmentList, "Value", "Text"), "Select Department", new { @class = "form-control  required-field" })
                                </div>
                            </div>
                            @Html.Hidden("DepartmentTableData", null, new { htmlAttributes = new { @class = "form-control", id = "DepartmentTableData" } })
                            <div class="form-group">
                                <span id="addbtn">
                                    <button class="btn btn-default" title="Add" type="button" onclick="insRow()"> Add Department</button>
                                    <span class="sr-only">Add Department</span>
                                </span>
                            </div>
                        </div>
                        <div>
                            <table id="DepartmentTable">
                                <tr>
                                    <td style="font-weight:bold">Departments </td>

                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="step-footer">
                    <div hidden="hidden">
                        <div class="col-md-offset-2 col-md-10" align="right">
                            <input type="submit" id="editLicense" value="edit" class="btn btn-outline-success" />
                        </div>
                    </div>
                    @if (Model.LicenseDetails.Status.StatusKey == StatusKeys.RefusalInProgress)
                    {
                        <div align="left" class="col-lg-3">
                            @Html.ActionLink(linkText: "Back to List", actionName: "Index", controllerName: "Refusals", routeValues: new { LicenseID = Model.LicenseDetails.LicenseId }, htmlAttributes: new { @class = "btn btn-outline-primary" })
                        </div>
                    }
                    else
                    {

                        <div align="left" class="col-lg-3">
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
                        </div>

                    }
                    <div align="center" class="col-lg-6">

                        <button data-direction="prev" class="btn btn-outline-primary">Previous</button>
                        <button data-direction="next" class="btn btn-outline-primary">Next</button>
                        <button data-direction="finish" class="btn btn-outline-success">Finish</button>
                    </div>

                </div>
                <br />
                <br />
                <br />

            </div>
        </div>
    }
    <script src="~/Scripts/jquery-steps.js"></script>

    <script type="text/javascript">
        $('#demo').steps({
            onFinish: function () { document.getElementById("editLicense").click(); }
        });

        $("table").addClass("table table-bordered")

        var TableData = new Array();
        var Selectedoptions = new Array();
        var id = 0;

        function getInspectorname(departmentID)
        {
            $.ajax
                  ({
                      url: '/License/PrepopulatInspector?departmentID= ' + departmentID,
                      data: JSON.stringify(),
                      method: 'post',
                      dataType: 'json',
                      contentType: 'application/json;charset=utf-8',
                      success: function (result) {
                          var items = '<option>Select</option>';
                          $.each(result, function (i, List) {
                              items += "<option value='" + List.Value + "'>" + List.Text + "</option>";
                          });
                          if (id == 0) {
                              $('#UserName').html(items);
                          }
                          else {
                              $('#UserName'+id).html(items);
                          }

                          if (result != "Error") {
                          }

                      }
                  })

        }

        function AddDoc(element) {
                        
            if (element == "") {

                document.getElementById("hidden" + element.id).value = "N/A";
            }
            else {
                var file_name = element.value.replace(/\\/g, '/').replace(/.*\//, '').replace(/\.[^/.]+$/, "")
                document.getElementById("hidden" +element.id).value = file_name;
            }

            addToArray();
        }
        function addcomment(element)
        {
                        
            if (element.value == "") {
                document.getElementById("value" + element.id).value = "N/A"
            }
            else {

                document.getElementById("value" + element.id).value = element.value;
            }

            addToArray();
        }
        function  selecteduser(element) {

            if (id == 0) {
                document.getElementById("User").value = element.value;
            }
            else {
                document.getElementById("User" + id).value = element.value;
            }
            addToArray();
        };
        function insRow() {

          
            var table = document.getElementById('DepartmentTable');
            var selectedoption = document.getElementById('DepartmentList');
            document.getElementById('DepartmentList').style.borderColor = "";
            document.getElementById("Erroralert").hidden = true;
            if (selectedoption.value != "") {
                getInspectorname(selectedoption.value)
                if (!table) return;
                var len = table.rows.length;

                var newRow = table.insertRow(1);
                var cellRefnum = newRow.insertCell(0);

                var newId = (len + 1);
                cellRefnum.innerHTML = '<div class="content"><div class="form-group">@Html.Label("Reference Number", new { @class = "control-label col-md-2" })<div class="col-md-4"><input type="hidden" id="Refnum" value=" " style="border-color:transparent" /><input type="text" value="" id="RefnumName" class="form-control" readonly /></div></div><div class="form-group">@Html.Label("Allocated Date", new { @class = "control-label col-md-2" })<div class="col-md-4"> <input type="hidden" id="AllocatedDate" value=" " style="border-color:transparent" /><input type="text" value="" id="AllocatedDateName" class="form-control" readonly /></div></div><br><div class="form-group">@Html.Label("Department", new { @class = "control-label col-md-2" })<div class="col-md-4"> <input type="hidden" id="DepartmentName" value=" " style="border-color:transparent" /><input type="text" value="" id="Departmenttext" class="form-control" readonly /></div></div><div class="form-group">@Html.Label("Status", new { @class = "control-label col-md-2" })<div class="col-md-4"> <input type="hidden" id="Status" value=" " style="border-color:transparent" /><input type="text" value="" id="StatusName" class="form-control" readonly /></div></div><div class="form-group">@Html.Label("Comment", new { @class = "control-label col-md-2" })<div class="col-md-4"> <input type="hidden" id="valueComment" value=" " style="border-color:transparent" /><textarea value="" id="Comment" class="form-control" onfocusout="addcomment(this)"> </textarea></div></div><div class="form-group">@Html.Label("Upload", new { @class = "control-label col-md-2" })<div class="col-md-4"><input type="hidden" id="hiddenfiles" value=" " style="border-color:transparent" /> <input type="file" name="files" id="files" onchange="AddDoc(this)"/> </div></div> </div><span id = "delbtn"><button id=' + newId + 'class="btn btn-outline-warning" title="Delete" type="button" onclick="deleteRow()">Remove</button><span class="sr-only">remove</span>'

                document.getElementById('RefnumName').value = "Ref" + "@Model.LicenseDetails.LicenseId";
                document.getElementById('AllocatedDateName').value = "@DateTime.Now.ToShortDateString()";
                document.getElementById('Refnum').value = "*Ref" + "@Model.LicenseDetails.LicenseId";
                document.getElementById('AllocatedDate').value = "@DateTime.Now.ToShortDateString()";
                document.getElementById('Status').value = "@Model.LicenseDetails.StatusId"
                document.getElementById('StatusName').value = "Awaiting Manager Response"
                document.getElementById('DepartmentName').value = selectedoption.value
                document.getElementById('valueComment').value = "N/A"
                document.getElementById('Departmenttext').value = selectedoption.options[selectedoption.selectedIndex].text;
                document.getElementById('hiddenfiles').value = "N/A"
                addToArray();

            }
            else
            {
                document.getElementById("Erroralert").hidden = false;
                document.getElementById("error2").innerHTML = " Please select a Department";
                document.getElementById('DepartmentList').style.borderColor = "Red";
            }
        }
        function deleteRow() {

            document.getElementById("Erroralert").hidden = true;
            var index = $(this).last("tr").index()
              document.getElementById("DepartmentTable").deleteRow(index);
            addToArray();
        }
        function addToArray() {
            
            $("#DepartmentTable tr").each(function (i, v) {
                TableData[i] = Array();
                Selectedoptions[i] = Array();
                $(this).find("div.col-md-4").each(function (ii, vv) {

                    var r = $(this);
                    TableData[i][ii] = $(this).find("input[type='hidden']").val();
                    Selectedoptions[i][ii] = $(this).find("input[type='text']").val();

                });
            })
            TableData.shift();
            Selectedoptions.shift();
;
            var data = TableData.join();

            document.getElementById("DepartmentTableData").value = data;
            $("#DepartmentList").val("");
        }
        var TableData2 = [];
        var Index = 1;
        function addToArrayP(payinslipnumber) {
            TableData2.push(payinslipnumber);
            var data = TableData2.join();
            document.getElementById("PayinslipNumberData").value = data;
        }
        function clear() {
            TableData2 = [];
            document.getElementById("PayinslipNumberData").value = "";
            document.getElementById("PayinslipNumber").value = "";
            $("#tblPaymentbody").empty();
        }
        function QueryPayInSlip() {
            addToArray(document.getElementById("PayinslipNumber").value);
            var PayinslipNumbers = document.getElementById("PayinslipNumberData").value;
            $.ajax
    ({
        url: '/License/QueryPayInSlip',
        data: JSON.stringify({ PayinslipNumbers: PayinslipNumbers }),
        method: 'post',
        dataType: 'json',
        contentType: 'application/json;charset=utf-8',
        success: function (result) {
            if (result != "Error" && result != "[]") {

                AddEntry(result);
            }
            else {
                clear();
            }
        },
        error: function (xhr, textStatus, error) {

            clear();
        },
    })
        };

        function AddEntry(result) {
            var jR = JSON.parse(result);
            document.getElementById("PayinslipNumber").value = "";
            $("#tblPayment").find("tr:not(:first)").remove();

            for (var i = 0; i < jR.length; i++) {
                var row = $("<tr />")
                $("#tblPayment").append(row);
                row.append($("<td>" + jR[i].PAYINSLIP_NO + "</td>"));
                row.append($("<td>" + jR[i].CUST_ACCT_NO + "</td>"));
                row.append($("<td>" + jR[i].SERVICE_UNIT + "</td>"));
                row.append($("<td>" + jR[i].REQUEST_NO + "</td>"));
                row.append($("<td>" + jR[i].PAYINSLIP_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].ALLOCATED_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].PAID_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].BALANCE_UNALLOCATED_AMOUNT + "</td>"));
                row.append($("<td>" + jR[i].PAYINSLIP_DATE + "</td>"));
                row.append($("<td>" + jR[i].PAID_DATE + "</td>"));

            }
        }
        $(document).ready(function () {
            var picker = new Pikaday({
                field: document.getElementById('PaymentDatedatetimepicker'),
                format: 'YYYY/MM/DD HH:MM',
                toString(date, format) {
                    var today = new Date();
                    const day = ('0' + (date.getDate())).slice(-2);
                    const month = ('0' + (date.getMonth() + 1)).slice(-2);
                    const year = date.getFullYear();
                    const hour = today.getHours();
                    const min = ('0' + today.getMinutes()).slice(-2);

                    return `${year}-${month}-${day} ${hour}:${min}`;
                }
            });


        });
    </script>
</body>
</html>