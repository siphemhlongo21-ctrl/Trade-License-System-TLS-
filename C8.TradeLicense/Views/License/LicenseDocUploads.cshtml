@model C8.TradeLicense.Models.License

@using C8.TradeLicense.DataAccessLayer;
@using C8.TradeLicense.Models;
@{
    ViewBag.Title = "License Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var clientDocs = (IEnumerable<FileUpload>)ViewData["clientDocs"];
    var BussinessDocs = (IEnumerable<FileUpload>)ViewData["BussinessDocs"];
    var InspectionRequestDocs = (IEnumerable<FileUpload>)ViewData["InspectionRequestDocs"];
    var InspectionDocs = (IEnumerable<FileUpload>)ViewData["InspectionDocs"];
    var RefusalDocs = (IEnumerable<FileUpload>)ViewData["RefusalDocs"];
    var RefusalsignDocs = (IEnumerable<FileUpload>)ViewData["RefusalsignDocs"];
    var AppealDocs = (IEnumerable< FileUpload>)ViewData["AppealDocs"];
    var InspectionRequestData = (IEnumerable<InspectionRequest>)ViewData["InspectionRequestData"];
    var InspectionData = (IEnumerable<InspectionResponse>)ViewData["InspectionData"];
    var RefusalData = (IEnumerable<Refusal>)ViewData["RefusalData"];
    var AppealData = (IEnumerable<InspectionAppeal>)ViewData["AppealData"];

    var db = new TradeLicenseDbContext();
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <strong>Error</strong> @TempData["Error"].ToString()
    </div>
}

<div class="alert alert-danger" hidden="hidden" id="Erroralert">
    <a class="close" data-dismiss="alert">×</a>

    <strong><p id="error2">error</p></strong>
</div>

<div id="errorResponse" class="alert alert-warning" style="display:none;">
</div>
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
