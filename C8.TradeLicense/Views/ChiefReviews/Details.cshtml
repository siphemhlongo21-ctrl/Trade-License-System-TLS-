@model C8.TradeLicense.Models.ChiefReview
@using C8.TradeLicense.DataAccessLayer
@using C8.TradeLicense.Models
@{
    ViewBag.Title = "Chief Review";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var InspectionResponse = (IEnumerable<InspectionResponse>)ViewData["InspectionResponse"];

    var User = (User)ViewData["Userdata"];
    var client = (Client)ViewData["ClientData"];
    var business = (Business)ViewData["BusinessData"];
    var DepartmentRequest = (IEnumerable<InspectionRequest>)ViewData["DepartmentRequest"];
    var DepartmentContact = (IEnumerable<DepartmentContact>)ViewData["DepartmentContactdata"];
    var licenseType = (LicenseType)ViewData["LicenseType"];
    var itemType = (ItemType)ViewData["ItemType"];
    var documentTypes = (IEnumerable<Document>)ViewData["Documents"];
    var AppealReview = (IEnumerable<InspectionAppealsReviews>)ViewData["AppealsReviews"];
    var AminReview = (IEnumerable<AdministratorReview>)ViewData["adminpreviousReview"];
    var ChiefReview = (IEnumerable<ChiefReview>)ViewData["ChiefpreviousReview"];
    var ManagerReview = (IEnumerable<ManagerReview>)ViewData["ManagerpreviousReview"];
    var InspectorDocs = (IEnumerable<FileUpload>)ViewData["InspectorDocs"];
    var license = (License)ViewData["licenceData"];
    var InspectiondocumentsList = (IEnumerable<FileUpload>)ViewData["inspectionUploadList"];
    var db = new TradeLicenseDbContext();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />

    <link rel="icon" type="image/png" href="assets/img/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="assets/img/favicon-32x32.png" sizes="32x32">

    <title>Trading License</title>

    <style>
        .number {
            background-color: transparent !important;
            border: 1.5px solid white;
            border-radius: 50px;
            color: white !important;
        }

        .step-app > .step-steps > li > a {
            display: block;
            padding: 10px;
            color: white;
            background-color: #848484;
            text-decoration: none;
            border-right: 1px solid #fff;
        }

        legend {
            display: block;
            width: 100%;
            padding: 0;
            margin-bottom: 20px;
            font-size: 25px;
            line-height: inherit;
            color: #333;
            border: 0;
            background-color: aliceblue;
            border-bottom: 1px solid #00d0ff;
        }
           .error {
        color: tomato;
    }
    </style>
</head>


<br />
<br />
<br />
<body class="disable_transitions sidebar_main_open sidebar_main_swipe">



    @using (Html.BeginForm("Create", "ChiefReviews", FormMethod.Post, new { id = "CreateForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @*Success message*@
        <div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
                    @*<a class="close" data-dismiss="alert">×</a>*@
                    @*<strong>Success!</strong>@TempData["Success"].ToString()*@
                    <span class="sr-only">Success: </span>
                    @TempData["Success"].ToString()
                </div>
            }
        </div>
        <div>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
                    @*<a href="#" class="close" data-dismiss="alert">&times;</a>
                        <strong>Error!</strong> @TempData["Error"].ToString()*@
                    <span class="sr-only">Error: </span>
                    @TempData["Error"].ToString()
                </div>
            }
        </div>
        <div>
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">
                    <a class="close" data-dismiss="alert">×</a>
                    <strong>Note!</strong>
                    @TempData["Info"].ToString()
                </div>
            }
        </div>

        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.License.LicenseId)
        @Html.HiddenFor(model => model.License.RegionId)
        @Html.HiddenFor(model => model.License.ApplicationDateTime)
        @Html.HiddenFor(model => model.License.LicenseTypeId)
        @Html.HiddenFor(model => model.License.ItemTypeId)
        @Html.HiddenFor(model => model.License.ItemConditionId)

        <div>
            @Html.HiddenFor(model => model.LicenseId, new { Value = @license.LicenseId })
        </div>

        <div id="demo">
            <div class="step-app">
                <ul class="step-steps">
                    <li><a href="#step1"><span class="number">1</span>License Holders Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step2"><span class="number">2</span>Business Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>

                    <li><a href="#step3"> <span class="number">3</span>License Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step4"> <span class="number">4</span>Department Circulation History <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step5"> <span class="number">5</span>Department Details <span class="glyphicon glyphicon-arrow-right"></span></a></li>
                    <li><a href="#step6"> <span class="number">6</span>Previous Review <span class="glyphicon glyphicon-arrow-right"></span></a></li>


                    <li><a href="#step7"> <span class="number">7</span> Chief Review</a></li>

                </ul>
                <div class="step-content">

                    <div class="step-tab-panel" id="step1" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_ClientPartial.cshtml")
                        <br>
                        <br>
                        <br>
                        <br>
                    </div>
                    <div class="step-tab-panel" id="step2" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_BusinessPartial.cshtml")
                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step3" align="center">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_LicencePartial.cshtml")
                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step4">
                        <br />
                        <br />
                        <br />
                        @Html.Partial("~/Views/Shared/_DepartmentcirculationHistoryPartial.cshtml")
                        <br />
                        <br />
                        <br />
                        <br />


                    </div>
                    <div class="step-tab-panel" id="step5" align="center">
                        <br />
                        <br />
                        <br />

                        @Html.Partial("~/Views/Shared/_InspectionResponsePartialList.cshtml")



                        <br />
                        <br />
                        <br />
                        <br />
                    </div>
                    <div class="step-tab-panel" id="step6" align="center">
                        <br />
                        <br />
                        <br />

                        @Html.Partial("~/Views/Shared/_ReviewPartial.cshtml")



                        <br />
                        <br />
                        <br />
                        <br />
                    </div>

                    <div class="step-tab-panel" id="step7">
                        <br />
                        <br />
                        <br />
                        <legend align="center">Review and Approval</legend>
                        <div class="form-horizontal">

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            @Html.HiddenFor(model => model.LicenseId, new { Value = license.LicenseId })


                            <div class="form-group">
                                @Html.LabelFor(model => model.UserId, "User Name", htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.Editor("Username", new { htmlAttributes = new { Value = @User.FullName, @class = "form-control" } })
                                    @Html.Hidden("Userid", User.UserId, new { htmlAttributes = new { Value = @User.UserId, @class = "form-control", @required = "required" } })


                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Decision, htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(model => model.Decision, new SelectList(new[] { "Recommend", "Not Recommended" }), "Select Decision", new { @class = "form-control", @required = "required" })
                                    @Html.ValidationMessageFor(model => model.Decision, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Comment, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.Comment, 8, 45, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.DateReviewed, htmlAttributes: new { @class = "control-label col-md-2 required-field" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.DateReviewed, new { htmlAttributes = new { @class = "form-control", @id = "DateReviewed", @required = "required" } })
                                    @Html.ValidationMessageFor(model => model.DateReviewed, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="form-group" hidden>
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" id="Createbtn" value="Create" class="btn btn-default" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="step-footer">


                    <div align="left" class="col-lg-3">
                        @Html.ActionLink("Back to List", "RejectedApplications", "License", null, new { @class = "btn btn-outline-primary" })
                    </div>
                    <div align="center" class="col-lg-6">
                        <button data-direction="prev" class="btn btn-outline-primary">Previous</button>
                        <button data-direction="next" class="btn btn-outline-primary">Next</button>

                    </div>
                    <br />
                    <br />

                </div>
            </div>
        </div>
    }
    <!-- Date Picker -->

    <script src="~/Scripts/datepicker/bootstrap-datepicker.js"></script>
    <link href="~/Scripts/datepicker/datepicker3.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-steps.js"></script>
    <script type="text/javascript">
        //$('#demo').steps({
        //    onFinish: function () { document.getElementById("Createbtn").click(); }
        //});
      
        $("table").addClass("table table-bordered")
        var form = $("#CreateForm");
        form.children("div").steps({

            onFinish: function () { document.getElementById("Createbtn").click(); },
            onChange: function (event, currentIndex, newIndex) {
                debugger;
                //submit(currentIndex, newIndex)

                if (newIndex < currentIndex) {
                    return true;
                }
                form.validate().settings.ignore = ":disabled,:hidden";
                return form.valid();

            }
        });
        $(document).ready(function () {
            $('#Username').prop("disabled", true);
        })


    </script>
</body>


</html>
