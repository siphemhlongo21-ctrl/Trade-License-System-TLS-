@model C8.TradeLicense.Models.Document

@{
    ViewBag.Title = "Create";
}

<div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span>
            <span class="sr-only">Success: </span>
            @TempData["Success"].ToString()

        </div>
    }
</div>
<div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <span class="glyphicon glyphicon-exclamation-sign" aria-hidden="true"></span>
            <span class="sr-only">Error: </span>
            @TempData["Error"].ToString()
        </div>
    }
</div>
<div>
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">
            <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
            <span class="sr-only">Info: </span>
            @TempData["Info"].ToString()
        </div>
    }
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true)
        @*<hr />*@
        @*<hr />*@

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Create Document</h3>
            </div>
            <div class="panel-collapse in">
                <div class="panel-body">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentName, new { @class = "control-label col-md-2  required-field" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DocumentName)
                            @Html.ValidationMessageFor(model => model.DocumentName)
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentDescription, new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DocumentDescription)
                            @Html.ValidationMessageFor(model => model.DocumentDescription)
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentKey, new { @class = "control-label col-md-2  required-field" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.DocumentKey)
                            @Html.ValidationMessageFor(model => model.DocumentKey)
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentTypeId, "Document Type", new { @class = "control-label col-md-2  required-field" })
                        <div class="col-md-10" style="width: 235px">
                            @Html.DropDownListFor(model => model.DocumentTypeId, new SelectList(ViewBag.DocumentTypeId, "DocumentTypeId", "DocumentTypeName"), "Select Document Type", new { @class = "form-control" })
                            @*@Html.DropDownList("DocumentTypeId", String.Empty)*@
                            @Html.ValidationMessageFor(model => model.DocumentTypeId)
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="submit" class="btn btn-outline-success" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary" })
</div>
